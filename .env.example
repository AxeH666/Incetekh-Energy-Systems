# Build-time public configuration. No private credentials belong here.
# Enable only in the approved production deployment environment.
# Set in Cloudflare BUILD variables, not Worker runtime Variables & Secrets.
# Production trigger: true after approval. Preview trigger: false.
# Never override Cloudflare's WORKERS_CI / WORKERS_CI_BRANCH metadata.
PUBLIC_SITE_INDEXABLE=false
# Optional public Cloudflare Web Analytics beacon token (32 hexadecimal characters).
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
# Optional Search Console HTML-tag verification value, not the whole meta tag.
PUBLIC_GOOGLE_SITE_VERIFICATION=
