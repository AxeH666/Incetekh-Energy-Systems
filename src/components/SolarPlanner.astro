---
import WhatsAppLink from './WhatsAppLink.astro';
import { solarSources, billSlider, estimateSolar } from '../data/solar';
const initial = estimateSolar({
  mode: 'bill',
  amount: billSlider.initial,
  tariff: billSlider.tariff,
  residential: true,
})!;
---

<section
  id="solar-planner"
  class="planner section"
  aria-labelledby="planner-heading"
>
  <div class="container">
    <div class="planning-heading">
      <div>
        <p class="eyebrow">Plan your solar</p>
        <h2 id="planner-heading" class="section-title">
          Find your perfect
          <br />
          solar size.
        </h2>
      </div>
      <p>
        Start with your electricity use. Get a useful first estimate, then let a
        free site visit refine the design.
      </p>
    </div>
    <div class="calculator" data-solar-calculator>
      <div class="calculator-inputs">
        <p class="state-label">Your state</p>
        <p class="state-value">Andhra Pradesh</p>
        <fieldset class="connection-switch" disabled>
          <legend>Connection type</legend>
          <div class="connection-options">
            <label>
              <input
                type="radio"
                name="solar-connection"
                value="residential"
                checked
              />
              <span>Residential</span>
            </label>
            <label>
              <input type="radio" name="solar-connection" value="commercial" />
              <span>Commercial</span>
            </label>
          </div>
        </fieldset>
        <label class="bill-label" for="solar-bill">
          Monthly electricity bill
        </label>
        <div class="bill-control">
          <p class="bill-value">
            <output for="solar-bill" data-bill-value aria-live="off">
              &#8377;2,500
            </output>
            <span>/ month</span>
          </p>
          <input
            id="solar-bill"
            type="range"
            min={billSlider.min}
            max={billSlider.max}
            step={billSlider.step}
            value={billSlider.initial}
            disabled
            aria-describedby="bill-help"
            aria-valuetext="2,500 rupees per month"
          />
          <div class="range-labels" aria-hidden="true">
            <span>&#8377;200</span>
            <span>&#8377;25,000</span>
            <span>&#8377;50,000</span>
          </div>
        </div>
        <p class="input-help" id="bill-help">
          Slide to your average monthly bill. Estimate uses &#8377;8 per unit;
          your actual tariff and usage may differ.
        </p>
      </div>
      <div class="calculator-result">
        <div
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-solar-result
        >
          <p class="eyebrow">Your starting point</p>
          <h3>
            <span data-result="kw">{initial.kw}</span>{' '}
            <span class="unit">kW</span>
          </h3>
          <p class="result-context">
            For approximately <span data-result="units">{initial.units}</span>{' '}
            units of monthly use.
          </p>
          <dl>
            <div>
              <dt>Estimated generation / month</dt>
              <dd>
                <span data-result="monthlyGeneration">
                  {initial.monthlyGeneration}
                </span>{' '}
                units
              </dd>
            </div>
            <div>
              <dt>Approximate clear roof area</dt>
              <dd>
                <span data-result="roofM2">{initial.roofM2}</span> m²{' '}
                <small>
                  (<span data-result="roofSqft">{initial.roofSqft}</span> sq ft)
                </small>
              </dd>
            </div>
            <div>
              <dt>Potential central subsidy</dt>
              <dd data-result="subsidy">Up to ₹78,000</dd>
            </div>
          </dl>
          <p class="result-note" data-subsidy-note>
            For an eligible residential installation. Approval and scheme
            conditions apply.
          </p>
        </div>
        <a class="button visit-link" href="#site-visit">
          Free site visit
        </a>
        <p class="result-note">
          A planning estimate, not a quotation or a generation guarantee. Final
          capacity depends on your roof, shade, sanctioned load and DISCOM
          approval.
        </p>
      </div>
    </div>
    <noscript>
      <p class="planner-note">
        Enable JavaScript to calculate your size. The 3 kW example above assumes
        313 units/month at an assumed &#8377;8/unit. You can still compare sizes
        below or contact us on WhatsApp.
      </p>
    </noscript>
    <details class="planning-details">
      <summary>How the estimate and subsidy work</summary>
      <div class="details-copy">
        <p>
          We estimate monthly units by dividing the bill by an assumed &#8377;8
          per unit. This does not reproduce DISCOM tariff slabs, fixed charges
          or credits. We then divide those units by 120 (4 units per kW per day
          × 30 days), then round up to a whole kW, with a 1 kW minimum. Roof
          planning allows about 10 m² per kW. These are starting assumptions:
          local weather, shading, orientation, access and equipment change the
          result. Use a 12-month consumption average where possible.
        </p>
        <p>
          PM Surya Ghar remains an active residential rooftop programme in the
          official sources checked on 30 September 2026. Standard central
          assistance is ₹30,000 per kW for the first 2 kW, plus ₹18,000 for the
          next kW: up to ₹78,000 from 3 kW onward. The calculator uses these
          Andhra Pradesh rates, excludes state top-ups, and is for new
          individual household systems. Commercial installations and solar water
          heaters do not qualify for this household rooftop-PV subsidy.
        </p>
        <p>
          Apply through the National Portal and confirm eligibility with your
          DISCOM before purchasing. Domestic-content requirements, a registered
          vendor, inspection and commissioning requirements apply.
          Existing-system expansions and previously claimed subsidies need an
          individual check. Subsidy is not an automatic discount or guaranteed
          payment.
        </p>
        <div class="source-links">
          <a class="text-link" href={solarSources.status}>
            MNRE programme update
          </a>
          <a class="text-link" href={solarSources.subsidy}>
            Official central subsidy rates
          </a>
          <a class="text-link" href={solarSources.portal}>
            PM Surya Ghar portal
          </a>
          <a class="text-link" href={solarSources.faq}>
            Rooftop solar FAQ
          </a>
        </div>
      </div>
    </details>

    <div class="efficiency-heading">
      <h2 class="section-title">Choose your efficiency.</h2>
      <p>
        Compare system capacity. A larger system produces more energy; it does
        not automatically mean higher panel efficiency.
      </p>
    </div>
    <div class="size-options">
      {[
        { kw: 3, title: 'Everyday home use' },
        { kw: 5, title: 'Growing energy needs' },
        { kw: 7, title: 'Higher-consumption homes' },
        { kw: 10, title: 'Larger roofs & businesses' },
      ].map(({ kw, title }) => (
        <article>
          <p class="size-value">
            {kw}
            {kw === 10 ? '+' : ''} <span>kW</span>
          </p>
          <h3>{title}</h3>
          <p>
            About {kw * 120} units / month
            <br />
            About {kw * 10} m² clear roof
          </p>
          <WhatsAppLink
            label={kw === 10 ? 'Talk to an expert' : `Explore ${kw} kW`}
            message={`Hi Incetekh, I am interested in a ${kw}${kw === 10 ? ' kW or larger' : ' kW'} solar system. Can we discuss a free site visit?`}
          />
        </article>
      ))}
    </div>
    <p class="planner-note">
      Figures use the same planning assumptions above; the 10+ kW example shows
      10 kW. No appliance-count or bill-saving guarantees. Eligible residential
      subsidy is capped at ₹78,000 for all four sizes; the household scheme
      excludes commercial connections.
    </p>
  </div>
</section>

<script>
  import '../scripts/solar-calculator';
</script>

<style>
  .planner {
    background: #eceee7;
  }
  .planning-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
  .planning-heading .eyebrow {
    margin-bottom: 1rem;
  }
  .planning-heading > p {
    max-width: 29rem;
    color: var(--color-muted);
  }
  .calculator {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1.5rem;
  }
  .calculator-inputs,
  .calculator-result {
    padding: clamp(1.5rem, 3vw, 3rem);
    min-width: 0;
    border-radius: 1rem;
  }
  .calculator-inputs {
    background: #dce5d5;
  }
  .state-label,
  legend,
  .bill-label {
    font-size: 0.8125rem;
    font-weight: 700;
  }
  .state-value {
    margin: 0.5rem 0 1.75rem;
    font-size: 1.125rem;
  }
  fieldset {
    padding: 0;
    margin: 0 0 2rem;
    border: 0;
    min-width: 0;
  }
  legend {
    margin-bottom: 0.75rem;
  }
  .connection-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
    border: 1px solid #b5c0b1;
    border-radius: 0.5rem;
    padding: 0.25rem;
    background: #fff;
  }
  .connection-options label {
    position: relative;
    min-width: 0;
    cursor: pointer;
  }
  .connection-options input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .connection-options span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border: 1px solid transparent;
    border-radius: 0.3rem;
    font-size: 0.875rem;
    padding: 0.5rem;
  }
  .connection-options input:checked + span {
    background: #075e54;
    color: #fff;
  }
  .connection-options input:focus-visible + span {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
  .bill-control {
    margin-top: 0.75rem;
    padding: 1.5rem;
    background: #fff;
    border-radius: 0.75rem;
  }
  .bill-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    justify-content: space-between;
  }
  .bill-value output {
    font-size: clamp(2rem, 3.5vw, 3rem);
    letter-spacing: -0.04em;
    font-weight: 600;
    color: #075e54;
  }
  .bill-value > span {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  input[type='range'] {
    display: block;
    width: 100%;
    min-width: 0;
    height: 3rem;
    margin: 1rem 0 0;
    padding: 0;
    accent-color: #075e54;
    cursor: pointer;
  }
  .range-labels {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--color-muted);
    font-size: 0.6875rem;
  }
  .input-help {
    color: var(--color-muted);
    font-size: 0.75rem;
    margin-top: 1rem;
  }
  .calculator-result {
    background: #20372d;
    color: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
  }
  .calculator-result h3 {
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 1rem 0;
    letter-spacing: -0.04em;
  }
  .unit {
    font-size: 0.5em;
    color: #c8d6c5;
  }
  .result-context {
    color: #d9e3d6;
  }
  dl {
    margin: 1.5rem 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  dl > div {
    padding: 1rem;
    background: #172e24;
    border-radius: 0.5rem;
  }
  dt {
    color: #d9e3d6;
    font-size: 0.8125rem;
  }
  dd {
    margin: 0.3rem 0 0;
    font-size: 1.4rem;
  }
  dd small {
    font-size: 0.8125rem;
    display: block;
  }
  .result-note {
    font-size: 0.75rem;
    color: #d9e3d6;
  }
  .visit-link {
    background: #fff;
    color: #18382e;
    align-self: start;
  }
  .calculator-result :global(:focus-visible) {
    outline-color: #ee865e;
  }
  .planning-details {
    border-bottom: 1px solid #c4cabe;
  }
  summary {
    padding: 1.25rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.875rem;
  }
  .details-copy {
    max-width: 65rem;
    padding: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .details-copy p + p {
    margin-top: 1rem;
  }
  .source-links {
    display: flex;
    gap: 0.5rem 1.5rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }
  .efficiency-heading {
    margin: 3.5rem 0 2rem;
  }
  .efficiency-heading p {
    max-width: 42rem;
    color: var(--color-muted);
    margin-top: 1rem;
  }
  .size-options {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .size-options article {
    border-top: 1px solid #b2bdb0;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .size-value {
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .size-value span {
    font-size: 1.25rem;
  }
  .size-options h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }
  .size-options article > p:not(.size-value) {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }
  .size-options :global(.button) {
    margin-top: auto;
  }
  .planner-note {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 1.5rem;
    max-width: 65rem;
  }
  @media (max-width: 64rem) {
    .size-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }
  @media (max-width: 56rem) {
    .calculator {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 44rem) {
    dl {
      grid-template-columns: 1fr;
    }
    .planning-heading,
    .calculator {
      grid-template-columns: 1fr;
    }
    .size-options {
      grid-template-columns: 1fr;
    }
    .planning-heading {
      gap: 1.5rem;
    }
  }
  @media (forced-colors: active) {
    .connection-options input:checked + span {
      outline: 2px solid Highlight;
      outline-offset: -3px;
    }
    input,
    select,
    .calculator {
      border: 1px solid CanvasText;
    }
  }
</style>
