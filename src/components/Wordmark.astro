---
import { Image } from 'astro:assets';
import logo from '../../incetekh_logo.png';
import { site } from '../data/site';
---

<a class="wordmark" href="/" aria-label={`${site.name} - home`}>
  <Image
    src={logo}
    alt="Incetekh Solar"
    width={176}
    height={140}
    fit="cover"
    position="center"
    format="webp"
    quality={90}
    loading="eager"
  />
</a>

<style>
  .wordmark {
    display: inline-flex;
    flex: 0 0 auto;
    background: #fff;
  }
  .wordmark img {
    width: 5.5rem;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 56rem) {
    .wordmark img {
      width: 5rem;
    }
  }
</style>
