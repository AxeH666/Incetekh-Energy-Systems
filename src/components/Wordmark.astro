---
import { site } from '../data/site';
---

<a class="wordmark" href="/" aria-label={`${site.name} — home`}>
  <span class="wordmark-name">
    INCETEKH<span aria-hidden="true">.</span>
  </span>
  <span class="wordmark-descriptor">ENERGY</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    color: inherit;
    text-decoration: none;
    line-height: 1;
    gap: 0.45rem;
    padding-block: 0.5rem;
  }
  .wordmark-name {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.06em;
  }
  .wordmark-name span {
    color: var(--color-accent-bright);
  }
  .wordmark-descriptor {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.38em;
  }
</style>
