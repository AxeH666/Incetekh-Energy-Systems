---
import { Image } from 'astro:assets';
import logo from '../../incetekh_logo.png';
import { site } from '../data/site';
---

<a class="wordmark" href="/" aria-label={`${site.name} - home`}>
  <Image
    src={logo}
    alt="Incetekh Solar"
    width={224}
    height={224}
    format="webp"
    quality={90}
    loading="eager"
  />
</a>

<style>
  .wordmark {
    display: inline-flex;
    flex: 0 0 auto;
    background: #fff;
  }
  .wordmark img {
    width: 7rem;
    height: 7rem;
    object-fit: contain;
  }
  @media (max-width: 56rem) {
    .wordmark img {
      width: 6rem;
      height: 6rem;
    }
  }
</style>
