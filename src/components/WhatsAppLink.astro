---
import { site } from '../data/site';
interface Props {
  label?: string;
}
const { label = 'Chat on WhatsApp' } = Astro.props;
---

<a class="button whatsapp-link" href={site.whatsapp}>
  <img
    src="/brand/whatsapp.svg"
    width="24"
    height="24"
    alt=""
    aria-hidden="true"
  />
  <span>
    {label}
    {!label.includes('WhatsApp') && <span class="sr-only"> on WhatsApp</span>}
  </span>
</a>
<style>
  .whatsapp-link {
    background: #075e54;
    color: #fff;
    justify-content: center;
    gap: 0.75rem;
  }
  .whatsapp-link:hover {
    background: #064c44;
  }
  img {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
</style>
