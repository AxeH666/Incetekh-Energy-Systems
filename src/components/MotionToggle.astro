---
interface Props {
  label: string;
  controls: string;
  class: string;
  strip?: boolean;
}
const { label, controls, class: className, strip } = Astro.props;
---

<button
  type="button"
  class:list={['motion-toggle', className]}
  aria-label={label}
  aria-controls={controls}
  data-paused="false"
  data-strip-toggle={strip || undefined}
  hidden
></button>

<style>
  /* No visible playback chrome; keyboard users retain a discoverable control. */
  .motion-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .motion-toggle:focus-visible {
    width: auto;
    height: auto;
    min-height: 44px;
    margin: 0;
    padding: 0.5rem 0.75rem;
    clip-path: none;
    overflow: visible;
    background: #fff;
    color: #202622;
    font: inherit;
    font-size: 0.8125rem;
    z-index: 2;
  }
  .motion-toggle::after {
    content: attr(aria-label);
  }
  .motion-toggle[hidden] {
    display: none;
  }
</style>
