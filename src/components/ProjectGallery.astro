---
import { Image } from 'astro:assets';
import MotionToggle from './MotionToggle.astro';
import { foundationImage } from '../data/site';
import equipment from '../../project photos/2.png';
import rooftop from '../../project photos/3.png';

const photos = [
  foundationImage,
  {
    src: equipment,
    alt: 'Illustrative solar equipment and rooftop scene.',
  },
  {
    src: rooftop,
    alt: 'Illustrative view of a large rooftop solar array.',
  },
];
---

<div class="project-gallery">
  <p class="sr-only" id="gallery-instructions">
    Solar photographs and illustrative supporting images. Use the dots or left
    and right arrow keys to choose a photo. Selecting a photo stops automatic
    playback.
  </p>
  <div
    class="gallery-track"
    id="solar-gallery"
    role="region"
    aria-roledescription="carousel"
    aria-label="Solar photo gallery"
    aria-describedby="gallery-instructions"
    tabindex="0"
  >
    <ul class="gallery-list">
      {photos.map((photo, index) => (
        <li
          class="gallery-slide"
          data-active={index === 0 ? 'true' : undefined}
        >
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[480, 800, 1280]}
            width={1280}
            sizes="(max-width: 896px) 90vw, (max-width: 1536px) 46vw, 640px"
            format="webp"
            quality={index === 0 ? 80 : 78}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </li>
      ))}
    </ul>
  </div>
  <div class="gallery-controls" hidden>
    <div class="gallery-dots" role="group" aria-label="Choose a photo">
      {photos.map((_, index) => (
        <button
          class="gallery-dot"
          type="button"
          aria-label={`Show photo ${index + 1} of ${photos.length}`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-controls="solar-gallery"
        >
          <span aria-hidden="true"></span>
        </button>
      ))}
    </div>
    <MotionToggle
      class="gallery-toggle"
      label="Pause gallery"
      controls="solar-gallery"
    />
  </div>
</div>

<style>
  .project-gallery {
    min-width: 0;
    position: relative;
    background: #314035;
    display: grid;
    align-self: center;
    border-radius: var(--radius);
  }
  .gallery-track {
    min-width: 0;
    border-radius: inherit;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }
  .gallery-track::-webkit-scrollbar {
    display: none;
  }
  .gallery-list {
    display: flex;
    min-height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
  }
  img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center top;
  }
  [data-ready] .gallery-track {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y pinch-zoom;
  }
  [data-ready] .gallery-list {
    display: grid;
    height: 100%;
  }
  [data-ready] .gallery-slide {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 700ms ease;
  }
  [data-ready] .gallery-slide[data-active] {
    opacity: 1;
  }
  .gallery-controls {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    padding: 0.25rem 0.5rem;
    filter: drop-shadow(0 1px 2px #000);
    color: #fff;
  }
  .gallery-controls[hidden] {
    display: none;
  }
  .gallery-controls :global(.motion-toggle:focus-visible) {
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
  }
  .gallery-dots {
    display: flex;
  }
  .gallery-dot {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .gallery-dot span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #cad4ce;
  }
  .gallery-dot[aria-pressed='true'] span {
    background: #fff;
    box-shadow: 0 0 0 2px #fff7;
  }
  :focus-visible {
    outline-color: #fff;
    outline-offset: -3px;
  }
  .gallery-controls :global(:focus-visible) {
    outline-color: #fff;
    outline-offset: -3px;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-ready] .gallery-slide {
      transition: none;
    }
  }
  @media (max-width: 56rem) {
    img {
      aspect-ratio: 1.6;
    }
  }
  @media (forced-colors: active) {
    .gallery-controls {
      background: Canvas;
      color: CanvasText;
    }
    .gallery-dot span {
      background: ButtonText;
      forced-color-adjust: none;
    }
    .gallery-dot[aria-pressed='true'] {
      outline: 2px solid Highlight;
      outline-offset: -8px;
    }
  }
  @media print {
    .gallery-controls {
      display: none;
    }
  }
</style>
