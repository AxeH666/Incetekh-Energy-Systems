---
import { productGroups } from '../data/products';
---

<section class="products-overview section" aria-labelledby="products-heading">
  <div class="container">
    <div class="products-heading">
      <h2 class="section-title" id="products-heading">
        Products we install.
      </h2>
      <a class="text-link" href="/products/">
        View all products
      </a>
    </div>
    <div class="product-categories">
      {productGroups.map((group) => (
        <article>
          <h3>{group.title}</h3>
          <p>{group.description}</p>
          <a class="text-link" href={`/products/#${group.id}`}>
            Explore {group.title.toLowerCase()}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .products-overview {
    border-bottom: 1px solid var(--color-line);
  }
  .products-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    margin-bottom: var(--heading-gap);
  }
  .product-categories {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  article {
    display: flex;
    flex-direction: column;
    align-items: start;
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-6);
  }
  h3 {
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
  }
  article p {
    max-width: 24rem;
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  article a {
    margin-top: auto;
    padding-top: var(--space-6);
  }
  @media (max-width: 44rem) {
    .products-heading {
      align-items: start;
      flex-direction: column;
      gap: var(--space-2);
    }
    .product-categories {
      grid-template-columns: 1fr;
    }
    article p {
      max-width: none;
    }
  }
</style>
