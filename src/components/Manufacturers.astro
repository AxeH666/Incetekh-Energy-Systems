---
import { Image } from 'astro:assets';
import waaree from '../../waree-logo - final.jpg';
import adani from '../../adani_logo.png';
import tata from '../../tata power solar logo.jpeg';
---

<section class="manufacturers" aria-labelledby="manufacturers-heading">
  <div class="container manufacturer-inner">
    <h2 id="manufacturers-heading">Trusted brands.</h2>
    <ul
      class="manufacturer-logos"
      aria-label="Manufacturers available through our sales channels"
    >
      <li class="waaree">
        <Image
          src={waaree}
          alt="Waaree"
          width={640}
          format="webp"
          quality={90}
        />
      </li>
      <li class="tata">
        <Image
          src={tata}
          alt="Tata Power Solar"
          width={402}
          format="webp"
          quality={90}
        />
      </li>
      <li class="adani">
        <Image
          src={adani}
          alt="Adani Solar"
          width={440}
          height={275}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
        />
      </li>
    </ul>
    <p class="manufacturer-note">
      Available through dealership and sales-channel relationships. Product
      availability and applicable warranties are confirmed in your written
      proposal.
    </p>
  </div>
</section>

<style>
  .manufacturers {
    background: #fff;
    border-bottom: 1px solid var(--color-line);
  }
  .manufacturer-inner {
    padding-block: clamp(2.5rem, 4vw, 4rem);
    text-align: center;
  }
  h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .manufacturer-logos {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(1rem, 5vw, 5rem);
  }
  li {
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: clamp(5rem, 10vw, 9rem);
  }
  img {
    width: 11rem;
    max-width: 85%;
    height: auto;
    object-fit: contain;
  }
  .waaree img {
    width: 15.25rem;
  }
  .tata img {
    width: 21.25rem;
    /* Show the horizontal wordmark from the supplied logo, as in the reference. */
    height: auto;
    aspect-ratio: 402 / 56;
    object-fit: cover;
    object-position: center 71%;
  }
  .manufacturer-note {
    max-width: 54rem;
    margin: var(--space-6) auto 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  @media (max-width: 36rem) {
    .manufacturer-logos {
      gap: 0.75rem;
      margin-top: var(--space-6);
    }
    .manufacturer-note {
      margin-top: var(--space-4);
    }
  }
</style>
