---
import { Image } from 'astro:assets';
import waaree from '../../waree-logo - final.jpg';
import adani from '../../adani_logo.png';
import tata from '../../tata power solar logo.jpeg';
---

<section class="manufacturers" aria-labelledby="manufacturers-heading">
  <div class="container manufacturer-inner">
    <div class="manufacturer-intro">
      <div>
        <p class="eyebrow">Manufacturers / sales channels</p>
        <h2 class="section-title" id="manufacturers-heading">
          Established names.
          <br />
          One point of contact.
        </h2>
      </div>
      <div class="prose">
        <p>
          Incetekh sells relevant products from Waaree, Adani Solar and Tata
          Power Solar through dealership and sales-channel relationships.
        </p>
        <p>
          Speak with us about product availability and suitability for your
          installation. Equipment selection and applicable warranties are set
          out in your written proposal.
        </p>
        <a class="text-link" href="/products/">
          Products we install: panels, inverters &amp; water heaters
        </a>
      </div>
    </div>
    <ul
      class="manufacturer-logos"
      aria-label="Manufacturers available through our sales channels"
    >
      <li class="waaree">
        <Image
          src={waaree}
          alt="Waaree"
          width={440}
          format="webp"
          quality={90}
        />
      </li>
      <li class="adani">
        <Image
          src={adani}
          alt="Adani Solar"
          width={320}
          height={200}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
        />
      </li>
      <li class="tata">
        <Image
          src={tata}
          alt="Tata Power Solar"
          width={320}
          height={210}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
        />
      </li>
    </ul>
  </div>
</section>

<style>
  .manufacturers {
    background: #fff;
  }
  .manufacturer-inner {
    padding-block: clamp(3rem, 5vw, 5rem);
  }
  .manufacturer-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .eyebrow {
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }
  .section-title {
    font-size: clamp(1.875rem, 2.8vw, 2.5rem);
  }
  .manufacturer-logos {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
  }
  li {
    min-width: 0;
    min-height: 8rem;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1.5rem 0.75rem 0;
  }
  img {
    width: 9rem;
    height: auto;
    object-fit: contain;
  }
  .waaree img {
    width: 11rem;
  }
  .tata img {
    width: 9.5rem;
  }
  @media (max-width: 44rem) {
    .manufacturer-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    li {
      min-height: 6rem;
      padding-inline: 0.5rem;
    }
  }
</style>
