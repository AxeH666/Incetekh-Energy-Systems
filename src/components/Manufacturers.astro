---
import { Image } from 'astro:assets';
import waaree from '../../waree-logo - final.jpg';
import adani from '../../adani_logo.png';
import tata from '../../tata power solar logo.jpeg';
---

<section class="manufacturers" aria-labelledby="manufacturers-heading">
  <div class="container manufacturer-inner">
    <h2 id="manufacturers-heading">Equipment brands.</h2>
    <a class="text-link product-link" href="/products/">
      View products
    </a>
    <ul
      class="manufacturer-logos"
      aria-label="Manufacturers available through our sales channels"
    >
      <li class="waaree">
        <Image
          src={waaree}
          alt="Waaree"
          width={440}
          format="webp"
          quality={90}
        />
      </li>
      <li class="adani">
        <Image
          src={adani}
          alt="Adani Solar"
          width={320}
          height={200}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
        />
      </li>
      <li class="tata">
        <Image
          src={tata}
          alt="Tata Power Solar"
          width={320}
          height={210}
          fit="cover"
          position="center"
          format="webp"
          quality={90}
        />
      </li>
    </ul>
    <p class="manufacturer-note">
      Available through dealership and sales-channel relationships. Product
      availability and applicable warranties are confirmed in your written
      proposal.
    </p>
  </div>
</section>

<style>
  .manufacturers {
    background: #fff;
    border-bottom: 1px solid var(--color-line);
  }
  .manufacturer-inner {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    column-gap: 2rem;
    align-items: center;
  }
  h2 {
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .product-link {
    grid-column: 3;
    grid-row: 1;
  }
  .manufacturer-logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-column: 2;
    grid-row: 1;
    gap: 1.5rem;
  }
  li {
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 5rem;
  }
  img {
    width: 7rem;
    height: auto;
    object-fit: contain;
  }
  .waaree img {
    width: 9rem;
  }
  .tata img {
    width: 7.5rem;
  }
  .manufacturer-note {
    grid-column: 1 / -1;
    margin-top: 1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  @media (max-width: 56rem) {
    .manufacturer-inner {
      grid-template-columns: 1fr auto;
      column-gap: 1rem;
    }
    .product-link {
      grid-column: 2;
    }
    .manufacturer-logos {
      grid-column: 1 / -1;
      grid-row: 2;
      gap: 1rem;
      margin-top: 1rem;
    }
    .manufacturer-note {
      max-width: 42rem;
    }
  }
  @media (max-width: 36rem) {
    .manufacturer-logos {
      gap: 0.75rem;
    }
  }
</style>
