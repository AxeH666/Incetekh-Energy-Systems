---
import Wordmark from './Wordmark.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { site } from '../data/site';
import { cities, cityPath } from '../data/cities';
import { sourcePath } from '../i18n/languages';
const path = sourcePath(Astro.url.pathname);
---

<footer class="site-footer" id="contact" tabindex="-1">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity">
        <Wordmark />
        <p class="footer-name">Incetekh Energy</p>
        <p>
          Solar engineering, procurement and construction. More than 13 years of
          experience, with care that continues after installation.
        </p>
      </div>
      <nav aria-label="Footer solutions">
        <p class="eyebrow">Solutions</p>
        <a href="/solar-guide/#residential">Residential solar</a>
        <a href="/services/">Commercial solar &amp; EPC</a>
        <a href="/financing/">Solar financing</a>
        <a href="/products/">Products we install</a>
        <a href="/projects/">Our projects</a>
        <a href="/about/">About Incetekh</a>
      </nav>
      <nav aria-label="Footer resources">
        <p class="eyebrow">Resources</p>
        <a href="/solar-guide/#subsidy">PM Surya Ghar guide</a>
        <a href="/#solar-planner">Subsidy calculator</a>
        <a href="/solar-guide/#maintenance">Panel maintenance</a>
        <a href="/contact/#complaints">File a complaint</a>
        <a href="/solar-guide/#faq">Solar FAQs</a>
        <a
          href="/terms/"
          aria-current={path === '/terms/' ? 'page' : undefined}
        >
          Terms &amp; conditions
        </a>
        <a
          href="/privacy/"
          aria-current={path === '/privacy/' ? 'page' : undefined}
        >
          Privacy policy
        </a>
      </nav>
      <div class="footer-contact">
        <h2 class="eyebrow">Contact us</h2>
        <a class="contact-link" href={`tel:${site.phone}`}>
          {site.phoneDisplay}
        </a>
        <a class="contact-link" href={`tel:${site.secondaryPhone}`}>
          {site.secondaryPhoneDisplay}
        </a>
        <a class="contact-link" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <address>
          <strong>{site.businessName}</strong>
          {site.address.map((line) => (
            <span>{line}</span>
          ))}
        </address>
        <WhatsAppLink />
      </div>
    </div>
    <div class="footer-region">
      <h2>Serving Andhra Pradesh. Based in Proddatur.</h2>
      <p>
        Planning solar in your city? Share your location so we can confirm
        site-visit availability.
      </p>
      <a class="text-link" href="/contact/">
        Discuss your location
      </a>
      <nav class="city-links" aria-label="Explore solar in your city">
        {cities.map((city) => (
          <>
            <a
              href={cityPath(city.slug)}
              aria-current={path === cityPath(city.slug) ? 'page' : undefined}
            >
              {city.name}
            </a>{' '}
          </>
        ))}
      </nav>
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-top: var(--section-space);
  }
  .footer-main {
    display: grid;
    grid-template-columns:
      minmax(0, 1.1fr) minmax(0, 0.8fr) minmax(0, 0.9fr)
      minmax(0, 1.3fr);
    gap: var(--space-8);
    align-items: start;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .footer-identity p {
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
    margin-top: var(--space-4);
  }
  .footer-identity .footer-name {
    color: var(--color-paper);
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin-top: 1.25rem;
  }
  .footer-name + p {
    margin-top: 0.5rem;
    max-width: 18rem;
  }
  nav {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 1.5rem;
    align-content: start;
  }
  nav p {
    grid-column: 1 / -1;
    color: var(--color-on-dark-muted);
    margin-bottom: 0.75rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-small);
    text-decoration: none;
    width: fit-content;
  }
  .footer-contact h2 {
    color: var(--color-on-dark-muted);
    margin-bottom: var(--space-4);
  }
  .contact-link {
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 2.75rem;
    font-size: var(--text-small);
    letter-spacing: -0.035em;
    text-decoration: none;
  }
  address {
    font-style: normal;
    font-size: 0.8125rem;
    color: var(--color-on-dark-muted);
    line-height: 1.8;
    margin: 1rem 0 1.5rem;
  }
  address span,
  address strong {
    display: block;
  }
  address strong {
    font-size: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .footer-region {
    border-top: 1px solid #444844;
    padding: var(--space-12) 0;
    text-align: center;
  }
  .footer-region h2 {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .footer-region p {
    font-size: var(--text-small);
    color: var(--color-on-dark-muted);
    margin: 0.75rem 0;
  }
  .footer-region a {
    font-size: 0.8125rem;
  }
  .city-links {
    display: block;
    text-wrap: balance;
    max-width: 64rem;
    margin: var(--space-6) auto 0;
  }
  .city-links a {
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
    padding-block: var(--space-2);
    margin-inline: var(--space-3);
  }
  .city-links a:hover,
  .city-links a[aria-current] {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }
  .footer-bottom {
    border-top: 1px solid #444844;
    padding-block: 1rem;
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
  }
  nav a:hover,
  .contact-link:hover,
  nav a:focus-visible,
  .contact-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
  }
  @media (max-width: 62rem) {
    .footer-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .footer-identity {
      grid-column: auto;
    }
    .footer-contact {
      max-width: 24rem;
    }
  }
  @media (max-width: 36rem) {
    .footer-main {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8) var(--space-4);
    }
    .footer-identity,
    .footer-contact {
      grid-column: 1 / -1;
    }
  }
</style>
