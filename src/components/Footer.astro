---
import Wordmark from './Wordmark.astro';
import { site, navigation } from '../data/site';
---

<footer class="site-footer" id="contact" tabindex="-1">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity">
        <Wordmark />
        <p>Engineering. Procurement. Construction.</p>
      </div>
      <nav aria-label="Footer navigation">
        <p class="eyebrow">Incetekh Energy</p>
        {navigation.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a href="/contact/">Contact</a>
      </nav>
      <div class="footer-contact">
        <h2 class="eyebrow">Arrange a free site visit</h2>
        <a class="phone-link" href={`tel:${site.phone}`}>
          <span>{site.phoneDisplay}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <a
        class="text-link"
        href="/privacy/"
        aria-current={Astro.url.pathname === '/privacy/' ? 'page' : undefined}
      >
        Privacy
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-top: var(--space-12);
  }
  .footer-main {
    display: flex;
    justify-content: space-between;
    gap: var(--space-8);
    padding-bottom: var(--space-12);
  }
  .footer-identity p {
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
    margin-top: var(--space-4);
  }
  nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 2rem;
    align-content: start;
  }
  nav p {
    grid-column: 1 / -1;
    color: var(--color-on-dark-muted);
    margin-bottom: 0.75rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-small);
    text-underline-offset: 0.3em;
  }
  .footer-contact h2 {
    color: var(--color-on-dark-muted);
    margin-bottom: var(--space-4);
  }
  .phone-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    min-height: 2.75rem;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    letter-spacing: -0.035em;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .phone-link span:last-child {
    color: var(--color-accent-bright);
  }
  .footer-bottom {
    border-top: 1px solid #444844;
    padding-block: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
  }
  @media (max-width: 62rem) {
    .footer-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .footer-contact {
      max-width: 24rem;
    }
  }
  @media (max-width: 36rem) {
    .footer-main {
      grid-template-columns: 1fr;
    }
  }
</style>
