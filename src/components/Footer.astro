---
import Wordmark from './Wordmark.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { site, navigation } from '../data/site';
---

<footer class="site-footer" id="contact" tabindex="-1">
  <div class="container">
    <div class="footer-main">
      <div class="footer-identity">
        <Wordmark />
        <p class="footer-name">Incetekh Energy</p>
        <p>Engineering. Procurement. Construction.</p>
      </div>
      <nav aria-label="Footer navigation">
        <p class="eyebrow">Explore</p>
        {navigation.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
      <div class="footer-contact">
        <h2 class="eyebrow">Arrange a free site visit</h2>
        <WhatsAppLink />
        <a class="phone-link" href={`tel:${site.phone}`}>
          <span>{site.phoneDisplay}</span>
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
      <a
        class="text-link"
        href="/privacy/"
        aria-current={Astro.url.pathname === '/privacy/' ? 'page' : undefined}
      >
        Privacy
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-top: clamp(2.5rem, 5vw, 4rem);
  }
  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .footer-identity p {
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
    margin-top: var(--space-4);
  }
  .footer-identity .footer-name {
    color: var(--color-paper);
    font-size: 1.5rem;
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin-top: 1.25rem;
  }
  .footer-name + p {
    margin-top: 0.5rem;
    max-width: 18rem;
  }
  nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 1.5rem;
    align-content: start;
  }
  nav p {
    grid-column: 1 / -1;
    color: var(--color-on-dark-muted);
    margin-bottom: 0.75rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-small);
    text-decoration: none;
    width: fit-content;
  }
  .footer-contact h2 {
    color: var(--color-on-dark-muted);
    margin-bottom: var(--space-4);
  }
  .phone-link {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    width: fit-content;
    min-height: 2.75rem;
    font-size: clamp(1.2rem, 1.75vw, 1.6rem);
    letter-spacing: -0.035em;
    text-decoration: none;
  }
  .footer-bottom {
    border-top: 1px solid #444844;
    padding-block: 1rem;
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
  }
  nav a:hover,
  .phone-link:hover,
  nav a:focus-visible,
  .phone-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
  }
  @media (max-width: 62rem) {
    .footer-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .footer-identity {
      grid-column: 1 / -1;
    }
    .footer-contact {
      max-width: 24rem;
    }
  }
  @media (max-width: 36rem) {
    .footer-main {
      grid-template-columns: 1fr;
    }
  }
</style>
