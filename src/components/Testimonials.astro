---
import { Image } from 'astro:assets';
import MotionToggle from './MotionToggle.astro';
import { reviewSamples } from '../data/review-samples';
---

<section
  class="reviews section"
  id="reviews"
  aria-labelledby="reviews-heading"
  data-review-status="illustrative"
  data-floating-strip
>
  <div class="container review-intro">
    <div>
      <p class="eyebrow">People & perspectives</p>
      <h2 class="section-title" id="reviews-heading">
        Good work. Word of mouth.
      </h2>
    </div>
    <MotionToggle
      class="review-toggle"
      label="Pause scrolling"
      controls="feedback-track"
      strip
    />
  </div>
  <p class="sr-only" id="review-instructions">
    Reviews move automatically. Use Pause scrolling to stop them, or focus this
    region and use the left and right arrow keys.
  </p>
  <div
    class="review-track"
    data-strip-track
    id="feedback-track"
    role="region"
    aria-label="Customer feedback"
    aria-describedby="review-instructions"
    tabindex="0"
  >
    <ul class="review-list" data-strip-list>
      {reviewSamples.map((review) => (
        <li class="review" data-review-id={review.id}>
          <Image
            src={review.image}
            alt={review.alt}
            width={640}
            height={review.cropHeight}
            widths={[320, 640]}
            sizes={
              review.cropHeight < 640
                ? `${(288 * 640) / review.cropHeight}px`
                : '(max-width: 704px) 78vw, 288px'
            }
            fit="cover"
            position="top"
            format="webp"
            quality={80}
            loading="lazy"
          />
          <div class="review-copy">
            <span class="quote-mark" aria-hidden="true">
              &#8220;
            </span>
            <p>{review.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    background: #eeeee8;
    overflow: clip;
  }
  .review-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: var(--space-4);
  }
  .eyebrow {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .review-intro :global(.review-toggle) {
    color: var(--color-muted);
  }
  .review-track {
    width: min(100% - var(--gutter) * 2, var(--content-width));
    margin-inline: auto;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding-block: 1.25rem 1.5rem;
    scrollbar-width: none;
  }
  .review-track::-webkit-scrollbar {
    display: none;
  }
  .review-list {
    display: flex;
    gap: 1.5rem;
    flex: none;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .review {
    width: 18rem;
    flex: none;
    align-self: start;
    background: #fff;
    border-radius: var(--radius);
    position: relative;
    transition:
      transform 240ms ease,
      box-shadow 240ms ease;
  }
  .review:nth-child(even) {
    margin-top: 2rem;
  }
  .review img {
    border-radius: var(--radius) var(--radius) 0 0;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }
  .review-copy {
    padding: 1rem 1.5rem 1.75rem;
  }
  .quote-mark {
    color: var(--color-accent);
    font-size: 2.5rem;
    line-height: 1;
    display: block;
  }
  .review-copy p {
    font-size: 1rem;
    line-height: 1.65;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .review:hover {
      transform: translateY(-8px) scale(1.035);
      box-shadow: 0 16px 28px -14px #20262255;
      z-index: 1;
    }
    .review:first-child {
      transform-origin: left center;
    }
    .review:last-child {
      transform-origin: right center;
    }
  }
  @media (max-width: 44rem) {
    .review-intro {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: var(--space-4);
    }
    .review {
      width: min(18rem, 78vw);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .review {
      transition: none;
    }
    .review-track {
      scroll-behavior: auto;
      scroll-snap-type: none;
    }
  }
  @media print {
    :global(.review-toggle) {
      display: none;
    }
    .review-track,
    .review-list {
      display: block;
      overflow: visible;
    }
    .review-list[aria-hidden] {
      display: none;
    }
    .review {
      break-inside: avoid;
    }
  }
</style>
