---
import { Image } from 'astro:assets';
import { reviewSamples } from '../data/review-samples';
---

<section
  class="reviews"
  id="reviews"
  aria-labelledby="reviews-heading"
  data-review-status="illustrative"
>
  <div class="container section">
    <div class="section-grid review-intro">
      <p class="eyebrow">Testimonials / preview</p>
      <div class="prose">
        <h2 class="section-title" id="reviews-heading">
          Customer perspectives.
        </h2>
        <p>
          The comments below are illustrative sample copy, not verified customer
          reviews. The installation photographs do not identify the author of
          any comment.
        </p>
      </div>
    </div>
    <div class="review-grid">
      {reviewSamples.map((sample) => (
        <article class="review" aria-labelledby={sample.id}>
          <Image
            src={sample.image}
            alt={sample.alt}
            width={800}
            height={800}
            widths={[400, 800]}
            sizes="(max-width: 704px) 90vw, 30vw"
            fit="cover"
            position="top"
            format="webp"
            quality={80}
            loading="lazy"
          />
          <h3 id={sample.id}>Sample copy — not a verified review</h3>
          <p class="sample-text">{sample.text}</p>
          <p class="photo-note">
            Installation photograph. No review attribution.
          </p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .reviews {
    background: #e9ece5;
  }
  .review-intro {
    margin-bottom: var(--space-12);
  }
  .review-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .review img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }
  h3 {
    color: var(--color-accent);
    font-size: var(--text-small);
    font-weight: 700;
    margin: var(--space-6) 0 var(--space-4);
  }
  .sample-text {
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  .photo-note {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin-top: var(--space-6);
  }
  @media (max-width: 44rem) {
    .review-grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
