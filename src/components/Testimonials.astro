---
import { Image } from 'astro:assets';
import { reviewSamples } from '../data/review-samples';
---

<section
  class="reviews section"
  id="reviews"
  aria-labelledby="reviews-heading"
  data-review-status="illustrative"
>
  <div class="container review-intro">
    <div>
      <p class="eyebrow">People & perspectives</p>
      <h2 class="section-title" id="reviews-heading">
        Good work. Word of mouth.
      </h2>
    </div>
    <button
      class="review-toggle"
      type="button"
      aria-controls="feedback-track"
      hidden
    >
      Pause scrolling
    </button>
  </div>
  <p class="sr-only" id="review-instructions">
    Reviews move automatically. Use Pause scrolling to stop them, or focus this
    region and use the left and right arrow keys.
  </p>
  <div
    class="review-track"
    id="feedback-track"
    role="region"
    aria-label="Customer feedback"
    aria-describedby="review-instructions"
    tabindex="0"
  >
    <ul class="review-list">
      {reviewSamples.map((review) => (
        <li class="review" data-review-id={review.id}>
          <Image
            src={review.image}
            alt={review.alt}
            width={640}
            height={review.cropHeight}
            widths={[320, 640]}
            sizes={
              review.cropHeight < 640
                ? `${(288 * 640) / review.cropHeight}px`
                : '(max-width: 704px) 78vw, 288px'
            }
            fit="cover"
            position="top"
            format="webp"
            quality={80}
            loading="lazy"
          />
          <div class="review-copy">
            <span class="quote-mark" aria-hidden="true">
              &#8220;
            </span>
            <p>{review.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .reviews {
    background: #eeeee8;
    overflow: clip;
  }
  .review-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }
  .eyebrow {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .review-toggle {
    flex-shrink: 0;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    color: var(--color-ink);
    background: transparent;
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
  }
  .review-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 0 var(--gutter) 1rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-muted) transparent;
  }
  .review-list {
    display: flex;
    gap: 1.5rem;
    flex: none;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .review {
    width: 18rem;
    flex: none;
    align-self: start;
    background: #fff;
  }
  .review:nth-child(even) {
    margin-top: 2rem;
  }
  .review img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }
  .review-copy {
    padding: 1rem 1.5rem 1.75rem;
  }
  .quote-mark {
    color: var(--color-accent);
    font-size: 2.5rem;
    line-height: 1;
    display: block;
  }
  .review-copy p {
    font-size: 1rem;
    line-height: 1.65;
  }
  @media (max-width: 44rem) {
    .review-intro {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .review {
      width: min(18rem, 78vw);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .review-track {
      scroll-behavior: auto;
      scroll-snap-type: none;
    }
  }
  @media print {
    .review-toggle {
      display: none;
    }
    .review-track,
    .review-list {
      display: block;
      overflow: visible;
    }
    .review-list[aria-hidden] {
      display: none;
    }
    .review {
      break-inside: avoid;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#reviews');
  const track = section?.querySelector<HTMLElement>('.review-track');
  const list = track?.querySelector<HTMLUListElement>('.review-list');
  const toggle = section?.querySelector<HTMLButtonElement>('.review-toggle');
  if (section && track && list && toggle) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let motionReduced = reducedMotion.matches;
    // One visual copy makes the boundary seamless. Assistive technology reads
    // the original list once; no links or focusable controls live in the copy.
    const copy = list.cloneNode(true) as HTMLUListElement;
    copy.setAttribute('aria-hidden', 'true');
    copy.inert = true;
    copy.querySelectorAll('img').forEach((img) => (img.alt = ''));
    let paused = false;
    let visible = false;
    let frame: number | null = null;
    let previousTime = 0;
    let position = 0;
    const cycleWidth = () =>
      list.getBoundingClientRect().width +
      parseFloat(getComputedStyle(track).columnGap);
    const canMove = () =>
      !paused &&
      visible &&
      !document.hidden &&
      !motionReduced &&
      document.activeElement !== track;
    const stop = () => {
      if (frame !== null) cancelAnimationFrame(frame);
      frame = null;
      previousTime = 0;
    };
    const tick = (time: number) => {
      frame = null;
      if (!canMove()) return;
      if (previousTime) {
        position =
          (position + Math.min(time - previousTime, 64) * 0.045) % cycleWidth();
        track.scrollLeft = position;
      }
      previousTime = time;
      frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      stop();
      toggle.hidden = motionReduced;
      if (motionReduced) {
        copy.remove();
      } else if (!copy.isConnected) track.append(copy);
      if (canMove()) {
        position = track.scrollLeft % cycleWidth();
        frame = requestAnimationFrame(tick);
      }
    };
    const updateLabel = () =>
      (toggle.textContent = paused ? 'Resume scrolling' : 'Pause scrolling');
    toggle.addEventListener('click', () => {
      paused = !paused;
      updateLabel();
      sync();
    });
    const pauseForInteraction = () => {
      paused = true;
      updateLabel();
      sync();
    };
    track.addEventListener('pointerdown', pauseForInteraction);
    // Vertical page scrolling must not silently turn off the floating strip.
    track.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaX) > 0 || event.shiftKey) pauseForInteraction();
      },
      { passive: true },
    );
    track.addEventListener('keydown', pauseForInteraction);
    track.addEventListener('focus', sync);
    track.addEventListener('blur', sync);
    reducedMotion.addEventListener('change', (event) => {
      motionReduced = event.matches;
      sync();
    });
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(track);
    sync();
  }
</script>
