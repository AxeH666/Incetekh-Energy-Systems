---
import { Image } from 'astro:assets';
import { reviewSamples } from '../data/review-samples';
---

<section
  class="reviews"
  id="reviews"
  aria-labelledby="reviews-heading"
  data-review-status="illustrative"
>
  <div class="container section">
    <div class="review-intro">
      <div>
        <p class="eyebrow">Customer perspectives</p>
        <h2 class="section-title" id="reviews-heading">
          A conversation that counts.
        </h2>
      </div>
      <div class="review-controls">
        <p class="scroll-hint" id="review-instructions">
          Scroll to explore <span aria-hidden="true">&#8596;</span>
          <span class="keyboard-hint">
            {' '}
            Use left and right arrow keys when focused.
          </span>
        </p>
        <button
          class="review-toggle"
          type="button"
          aria-controls="feedback-track"
          hidden
        >
          Pause scrolling
        </button>
      </div>
    </div>
    <div
      class="review-track"
      id="feedback-track"
      role="region"
      aria-label="Customer feedback"
      aria-describedby="review-instructions"
      tabindex="0"
    >
      <ul class="review-list">
        {reviewSamples.map((review, index) => (
          <li class="review">
            <Image
              src={review.image}
              alt={review.alt}
              width={640}
              height={review.cropHeight}
              widths={[320, 640]}
              sizes="(max-width: 704px) 75vw, 320px"
              fit="cover"
              position="top"
              format="webp"
              quality={75}
              loading="lazy"
            />
            <span class="review-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')} /
            </span>
            <p class="review-text">{review.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .reviews {
    background: #e9ece5;
  }
  .review-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .section-title {
    max-width: 24rem;
  }
  .scroll-hint {
    color: var(--color-muted);
    font-size: var(--text-small);
    flex-shrink: 0;
  }
  .scroll-hint span[aria-hidden] {
    margin-left: 0.75rem;
    font-size: 1.5rem;
  }
  .keyboard-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .review-track {
    overflow-x: auto;
    scroll-snap-type: none;
    overscroll-behavior-x: contain;
    scrollbar-color: var(--color-muted) transparent;
    padding-bottom: 1.25rem;
  }
  .review-list {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }
  .review {
    flex: 0 0 clamp(17rem, 27vw, 20rem);
    padding-bottom: 1.5rem;
  }
  .review img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 65% center;
    margin-bottom: 1.25rem;
  }
  .review-controls {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .review-toggle {
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-muted);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
  }
  .review-toggle:hover {
    background: var(--color-paper);
  }
  .review-number {
    display: block;
    color: var(--color-accent);
    font-size: var(--text-small);
    margin-bottom: 0.75rem;
  }
  .review-text {
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.55;
    letter-spacing: -0.02em;
  }
  @media (max-width: 44rem) {
    .review-intro {
      flex-direction: column;
      align-items: start;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .review {
      flex-basis: 85%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .review-track {
      scroll-behavior: auto;
      scroll-snap-type: none;
    }
  }
  @media print {
    .review-controls {
      display: none;
    }
    .review-track {
      overflow: visible;
    }
    .review-list {
      display: block;
    }
    .review {
      break-inside: avoid;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#reviews');
  const track = section?.querySelector<HTMLElement>('.review-track');
  const toggle = section?.querySelector<HTMLButtonElement>('.review-toggle');
  if (section && track && toggle) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    let hovering = false;
    let visible = false;
    let frame: number | null = null;
    let previousTime = 0;
    let position = track.scrollLeft;
    const canMove = () =>
      !paused &&
      !hovering &&
      visible &&
      !document.hidden &&
      !reducedMotion.matches &&
      !section.contains(document.activeElement);
    const updateLabel = () => {
      toggle.textContent = paused ? 'Resume scrolling' : 'Pause scrolling';
    };
    const stop = () => {
      if (frame !== null) cancelAnimationFrame(frame);
      frame = null;
      previousTime = 0;
    };
    const tick = (time: number) => {
      frame = null;
      if (!canMove()) return;
      if (previousTime) {
        position += Math.min(time - previousTime, 64) * 0.025;
        const end = track.scrollWidth - track.clientWidth;
        track.scrollLeft = Math.min(position, end);
        if (position >= end) {
          paused = true;
          updateLabel();
          stop();
          return;
        }
      }
      previousTime = time;
      frame = requestAnimationFrame(tick);
    };
    const sync = () => {
      stop();
      toggle.hidden = reducedMotion.matches;
      if (canMove()) {
        position = track.scrollLeft;
        frame = requestAnimationFrame(tick);
      }
    };
    toggle.addEventListener('click', () => {
      paused = !paused;
      if (
        !paused &&
        track.scrollLeft >= track.scrollWidth - track.clientWidth - 1
      )
        track.scrollLeft = 0;
      updateLabel();
      sync();
    });
    section.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') {
        hovering = true;
        sync();
      }
    });
    section.addEventListener('pointerleave', () => {
      hovering = false;
      sync();
    });
    section.addEventListener('focusin', sync);
    section.addEventListener('focusout', () => requestAnimationFrame(sync));
    // Manual scrolling stays under the visitor's control until they choose Resume.
    const pauseForInteraction = () => {
      paused = true;
      updateLabel();
      sync();
    };
    track.addEventListener('pointerdown', pauseForInteraction);
    track.addEventListener('wheel', pauseForInteraction, { passive: true });
    track.addEventListener('keydown', pauseForInteraction);
    reducedMotion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        sync();
      },
      { threshold: 0.2 },
    ).observe(track);
    sync();
  }
</script>
