---
import Wordmark from './Wordmark.astro';
const isHome = Astro.url.pathname === '/';
---

<header class="site-header">
  <div class="container header-inner">
    <Wordmark />
    <nav aria-label="Main navigation">
      <a class="home-link" href="/" aria-current={isHome ? 'page' : undefined}>
        Home
      </a>
      <a class="button button-dark" href="#contact">
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
  }
  .header-inner {
    min-height: 6.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    font-size: var(--text-small);
  }
  .home-link:not([aria-current]) {
    text-decoration: none;
  }
  @media (max-width: 35rem) {
    .button {
      gap: var(--space-3);
      padding-inline: var(--space-3);
    }
    .header-inner {
      min-height: 5.5rem;
      flex-wrap: wrap;
    }
    /* The wordmark remains the home link on narrow screens. */
    .home-link {
      display: none;
    }
  }
</style>
