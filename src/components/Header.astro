---
import Wordmark from './Wordmark.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { navigation } from '../data/site';
import LanguageMenu from './LanguageMenu.astro';
import { languages, localPath, sourcePath } from '../i18n/languages';
const path = sourcePath(Astro.url.pathname);
---

<header class="site-header">
  <div class="container header-inner">
    <Wordmark />
    <nav aria-label="Main navigation">
      {navigation.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <WhatsAppLink label="WhatsApp" />
      <LanguageMenu
        current="en"
        options={languages.map((language) => ({
          ...language,
          href: localPath(path, language.code),
        }))}
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-line);
    background: #fff;
  }
  .header-inner {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    padding-block: var(--space-2);
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    margin-left: auto;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
    font-size: var(--text-small);
    font-weight: 600;
    padding-inline: 0.25rem;
  }
  nav a:not([aria-current]) {
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: none;
  }
  @media (max-width: 64rem) {
    :global(html:not([lang='en'])) .header-inner {
      flex-wrap: wrap;
    }
    :global(html:not([lang='en'])) nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
      flex-wrap: wrap;
      border-top: 1px solid var(--color-line);
      padding-top: var(--space-2);
    }
    .header-inner {
      gap: 0.5rem 1rem;
    }
    nav {
      gap: 0.5rem;
    }
    .header-actions :global(.whatsapp-link) {
      width: 3rem;
      padding-inline: 0;
    }
    .header-actions :global(.whatsapp-link > span) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 44rem) {
    .header-inner {
      min-height: 0;
      gap: 0.5rem 1rem;
      flex-wrap: wrap;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      justify-content: space-between;
      gap: 0.25rem 0.5rem;
      border-top: 1px solid var(--color-line);
      padding-top: var(--space-2);
      flex-wrap: wrap;
    }
    nav a {
      font-size: 0.8125rem;
      padding-inline: 0;
    }
  }
  @media (max-width: 36rem) {
    .header-inner {
      column-gap: 0.5rem;
    }
    .header-actions {
      gap: 0.25rem;
    }
  }
</style>
