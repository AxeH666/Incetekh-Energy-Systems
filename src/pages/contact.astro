---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
import WhatsAppLink from '../components/WhatsAppLink.astro';
---

<SiteLayout
  title="Contact & Free Site Visits | Incetekh Energy"
  description="Call Incetekh Energy on +91 94401 68111 to discuss rooftop solar, arrange a free site visit, or ask about system performance checks and annual yield audits."
>
  <PageIntro
    eyebrow="Start a conversation"
    title="Let’s talk about your site."
    description="Planning rooftop solar or looking at an existing system? Message us on WhatsApp or call to arrange a free site visit, performance check or annual yield audit."
  />
  <section class="container contact-grid" aria-labelledby="call-heading">
    <div class="call-panel">
      <h2 class="eyebrow" id="call-heading">
        Speak with Incetekh Energy
      </h2>
      <div class="whatsapp-action">
        <WhatsAppLink />
      </div>
      <a
        class="contact-number"
        href={`tel:${site.phone}`}
        aria-label={`Call ${site.phoneDisplay}`}
      >
        94401 68111
      </a>
      <a
        class="contact-secondary"
        href={`tel:${site.secondaryPhone}`}
        aria-label={`Call ${site.secondaryPhoneDisplay}`}
      >
        {site.secondaryPhoneDisplay}
      </a>
      <a class="text-link" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <address>
        <strong>{site.businessName}</strong>
        {site.address.map((line) => (
          <span>{line}</span>
        ))}
      </address>
      <p>Calling from outside India? Use {site.phoneDisplay}.</p>
      <p>
        Tell us your site location and the support you are looking for. We’ll
        discuss suitability and visit arrangements with you.
      </p>
    </div>
    <div class="prose preparation">
      <h2 class="section-title">A useful first conversation.</h2>
      <p>If available, have these details to hand:</p>
      <ul>
        <li>Your site location and building type.</li>
        <li>A recent electricity bill or a sense of your energy use.</li>
        <li>Whether this is a new installation or an existing solar system.</li>
        <li>
          Any questions about your roof, system performance or next steps.
        </li>
      </ul>
      <p>You don’t need all the answers before calling.</p>
    </div>
  </section>
  <section
    class="container section section-grid questions"
    aria-labelledby="questions-heading"
  >
    <h2 class="section-title" id="questions-heading">
      Before we speak.
    </h2>
    <div>
      <details>
        <summary>Is the site visit free?</summary>
        <p>
          Yes. Call to arrange a free site visit. We’ll confirm the location and
          visit arrangements with you.
        </p>
      </details>
      <details>
        <summary>Can I ask about an existing system?</summary>
        <p>
          Yes. Incetekh offers free system performance checks and free annual
          yield audits. Tell us about your installation and what you would like
          checked.
        </p>
      </details>
      <details>
        <summary>What does the 5-year warranty cover?</summary>
        <p>
          The 5-year warranty is subject to your written proposal and applicable
          terms. Ask us to explain the coverage, exclusions and responsibilities
          for your system before proceeding.
        </p>
      </details>
      <a class="text-link" href="/services/">
        See Our Services
      </a>
    </div>
  </section>
  <section
    id="complaints"
    class="container section section-grid questions"
    aria-labelledby="complaints-heading"
  >
    <h2 class="section-title" id="complaints-heading">
      Service &amp; complaints.
    </h2>
    <div class="prose">
      <p>
        Tell us your name, installation location, a callback number and what has
        happened. Include your invoice or project reference if available, plus
        any inverter error code. Photos can help when it is safe to take them.
      </p>
      <p>
        Email your concern to our support address or open WhatsApp below. Review
        and send the message in your chosen app; opening a link does not lodge a
        complaint automatically. Keep your sent message for follow-up.
      </p>
      <a
        class="text-link"
        href={`mailto:${site.email}?subject=Service%20complaint`}
      >
        Email a complaint
      </a>
      <WhatsAppLink
        label="Discuss a service issue"
        message="Hi Incetekh, I need help with a service issue. My installation location is: "
      />
      <p>
        For smoke, exposed wiring or a burning smell, keep clear of the
        equipment and contact qualified emergency/electrical help. Do not open
        the inverter or handle live wiring.
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  address {
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.8;
    margin-top: 1rem;
  }
  address span,
  address strong {
    display: block;
  }
  .whatsapp-action {
    margin-top: 1.5rem;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--layout-gap);
    padding-bottom: var(--section-space);
  }
  .call-panel {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: var(--card-padding);
    border-radius: var(--radius);
    align-self: start;
  }
  .call-panel p {
    color: var(--color-on-dark-muted);
    margin-top: var(--space-6);
  }
  .call-panel :focus-visible {
    outline-color: var(--color-accent-bright);
  }
  .contact-number {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: clamp(1.75rem, 3.5vw, 3.5rem);
    letter-spacing: -0.05em;
    line-height: 1.4;
    margin-top: var(--space-8);
    min-height: 2.75rem;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .preparation .section-title {
    font-size: clamp(1.75rem, 3vw, 3rem);
  }
  .contact-secondary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    width: fit-content;
    margin-block: var(--space-2) var(--space-4);
    font-size: 1.125rem;
    text-underline-offset: 0.2em;
  }
  ul {
    padding-left: 1.25rem;
    color: var(--color-muted);
  }
  li + li {
    margin-top: var(--space-3);
  }
  .questions {
    border-top: 1px solid var(--color-line);
  }
  details {
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-6);
  }
  details:first-child {
    padding-top: 0;
  }
  summary {
    min-height: 2.75rem;
    cursor: pointer;
    font-size: var(--text-lead);
    font-weight: 600;
    padding-block: var(--space-2);
  }
  details p {
    margin-top: var(--space-4);
    color: var(--color-muted);
    max-width: 44rem;
  }
  .questions .text-link {
    margin-top: var(--space-6);
  }
  #complaints .prose > :global(.button) {
    display: flex;
    width: fit-content;
  }
  @media (max-width: 44rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
