---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteVisitForm from '../components/SiteVisitForm.astro';
import Manufacturers from '../components/Manufacturers.astro';
import ApprovedVendors from '../components/ApprovedVendors.astro';
import ProductOverview from '../components/ProductOverview.astro';
import Testimonials from '../components/Testimonials.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import SolarPlanner from '../components/SolarPlanner.astro';
import { metalRoofImage } from '../data/site';
---

<SiteLayout title="Incetekh Energy | Solar Engineering & EPC">
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-inner">
      <div class="intro">
        <p class="eyebrow">Incetekh Energy / Solar EPC</p>
        <h1 id="page-title">
          Solar engineering.
          <br />
          <span>Built on experience.</span>
        </h1>
        <div class="intro-copy">
          <p>
            More than 13 years of experience. Engineering, procurement and
            construction, with care that continues after installation.
          </p>
          <a class="button hero-visit" href="#site-visit">
            Book a free site visit
          </a>
          <a class="hero-link text-link" href="/projects/">
            Explore our work
          </a>
        </div>
        <div class="proof-line">
          <p class="project-proof">
            <strong>500+</strong> projects completed
          </p>
          <p>
            <strong>13+</strong> years of experience
          </p>
          <a class="text-link" href="/about/">
            Meet Incetekh
          </a>
        </div>
      </div>
      <ProjectGallery />
    </div>
  </section>

  <Manufacturers />
  <ProductOverview />
  <ApprovedVendors />

  <section
    class="container project-story section"
    aria-labelledby="experience-heading"
  >
    <figure>
      <Image
        src={metalRoofImage.src}
        alt={metalRoofImage.alt}
        widths={[480, 800, 1080]}
        sizes="(max-width:896px) 90vw, 45vw"
        format="webp"
        quality={80}
      />
      <figcaption>From the Incetekh project archive</figcaption>
    </figure>
    <div class="project-story-copy">
      <p class="eyebrow">From planning to the rooftop</p>
      <h2 id="experience-heading" class="section-title">
        One team.
        <br />
        Every stage of solar.
      </h2>
      <p class="lead">Engineering. Procurement. Construction.</p>
      <p>
        We bring the site, equipment and installation together, with ongoing
        system care after the work is complete.
      </p>
      <p class="warranty-note">
        <strong>5-year warranty</strong>
        <br />
        Subject to the written proposal and applicable warranty terms.
      </p>
      <a class="text-link" href="/services/">
        See our services
      </a>
    </div>
  </section>
  <Testimonials />
  <SolarPlanner />
  <section
    class="free-services section"
    aria-labelledby="free-services-heading"
  >
    <div class="container">
      <div class="services-intro">
        <div>
          <p class="eyebrow">Three services. No charge.</p>
          <h2 class="section-title" id="free-services-heading">
            Free services.
            <br />
            Care beyond installation.
          </h2>
        </div>
        <p>
          Planning a new installation or looking after an existing one? Start
          with the support you need, free of charge.
        </p>
      </div>
      <div class="free-service-list">
        <a href="/services/#site-visit">
          <span class="service-label">01 / Free</span>
          <h3>Site visits</h3>
          <p>Talk through your site, roof space and solar plans with us.</p>
          <span class="service-detail-link">Explore site visits</span>
        </a>
        <a href="/services/#system-care">
          <span class="service-label">02 / Free</span>
          <h3>System performance checks</h3>
          <p>Understand how your existing solar system is performing.</p>
          <span class="service-detail-link">Explore performance checks</span>
        </a>
        <a href="/services/#system-care">
          <span class="service-label">03 / Free</span>
          <h3>Annual yield audits</h3>
          <p>Review your system's energy generation over the year.</p>
          <span class="service-detail-link">Explore yield audits</span>
        </a>
      </div>
    </div>
  </section>

  <SiteVisitForm />
</SiteLayout>

<style>
  .hero-visit {
    background: #f5f4ef;
    color: #172720;
  }
  .hero-visit:hover {
    background: #dfe8d9;
  }
  .hero {
    background: #172720;
    color: #fff;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    width: min(100% - var(--gutter) * 2, var(--content-width));
    margin: auto;
    gap: var(--layout-gap);
    padding-block: var(--space-12);
  }
  .intro {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .intro .eyebrow {
    color: #c9d6c8;
    margin-bottom: var(--space-6);
  }
  h1 {
    font-size: clamp(2.5rem, 3.8vw, 4.25rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }
  h1 span {
    color: #c2d0c1;
  }
  .intro-copy {
    margin-top: var(--space-6);
    max-width: 28rem;
  }
  .intro-copy p {
    color: #d2dcd3;
    font-size: var(--text-lead);
    margin-bottom: var(--space-6);
  }
  .hero-link {
    display: flex;
    width: fit-content;
    margin-top: 0.75rem;
    color: #fff;
  }
  .hero :focus-visible {
    outline-color: #f7b097;
  }
  .proof-line {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid #ffffff30;
  }
  .proof-line p {
    color: #d2dcd3;
    font-size: var(--text-small);
  }
  .proof-line strong {
    display: block;
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    color: #fff;
    line-height: 1.3;
  }
  .proof-line a {
    grid-column: 1 / -1;
    width: fit-content;
  }
  .free-services {
    background: #fff;
  }
  .services-intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--layout-gap);
    align-items: end;
    margin-bottom: var(--heading-gap);
  }
  .services-intro > p {
    max-width: 29rem;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .eyebrow {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .free-service-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .free-service-list > a {
    display: flex;
    flex-direction: column;
    align-items: start;
    text-decoration: none;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .service-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .free-service-list h3 {
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.035em;
    margin: 1.25rem 0 1rem;
    max-width: 20rem;
  }
  .free-service-list p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    max-width: 22rem;
  }
  .service-detail-link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    font-size: var(--text-small);
    font-weight: 600;
    padding-top: 1.5rem;
    margin-top: auto;
  }
  .free-service-list a:hover .service-detail-link {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .project-story {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--layout-gap);
    align-items: center;
  }
  .project-story img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .project-story figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .project-story-copy > p:not(.eyebrow) {
    margin-top: var(--space-4);
    max-width: 28rem;
    color: var(--color-muted);
  }
  .warranty-note {
    font-size: var(--text-small);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .warranty-note strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .project-story .text-link {
    margin-top: 1.5rem;
  }
  @media (max-width: 56rem) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding-block: var(--space-8);
    }
    .services-intro,
    .project-story {
      grid-template-columns: 1fr;
    }
    .services-intro {
      gap: 1.5rem;
    }
    .project-story img {
      aspect-ratio: 1.6;
    }
  }
  @media (max-width: 44rem) {
    h1 {
      font-size: clamp(2.5rem, 8.5vw, 3.75rem);
    }
    .free-service-list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .free-service-list h3 {
      max-width: none;
      margin-top: 0.75rem;
    }
    .free-service-list p {
      max-width: none;
    }
  }
</style>

<script>
  import '../scripts/floating-strips';
  import '../scripts/photo-slideshow';
</script>
