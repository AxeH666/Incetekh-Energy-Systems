---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteCTA from '../components/SiteCTA.astro';
import Manufacturers from '../components/Manufacturers.astro';
import Testimonials from '../components/Testimonials.astro';
import { foundationImage, metalRoofImage, site } from '../data/site';
---

<SiteLayout title="Incetekh Energy | Solar Engineering & EPC">
  <section class="intro container" aria-labelledby="page-title">
    <p class="eyebrow intro-label">
      <span aria-hidden="true"></span> Incetekh Energy / Solar EPC
    </p>
    <div class="intro-grid">
      <h1 id="page-title">
        Solar engineering.
        <br />
        <span>Built on experience.</span>
      </h1>
      <div class="intro-copy">
        <p>
          More than 13 years of experience in solar engineering, procurement and
          construction. From the first site visit to ongoing system care.
        </p>
        <a class="button button-dark" href={`tel:${site.phone}`}>
          Arrange a free site visit <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <figure class="project-image container">
    <Image
      src={foundationImage.src}
      alt={foundationImage.alt}
      widths={[480, 800, 1280]}
      sizes="(min-width: 1500px) 1344px, 91vw"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <figcaption>
      <span class="project-proof">
        <strong>500+</strong> projects completed
      </span>
      <a class="text-link" href="/projects/">
        View Projects <span aria-hidden="true">↗</span>
      </a>
    </figcaption>
  </figure>
  <section
    class="container company-summary"
    aria-labelledby="experience-heading"
  >
    <div>
      <p class="eyebrow">About Incetekh</p>
      <h2 id="experience-heading" class="section-title">
        Built through work.
        <br />
        Grown by word of mouth.
      </h2>
    </div>
    <div class="prose">
      <p class="lead">
        An established solar EPC business, with experience that starts on the
        roof.
      </p>
      <p>
        We bring together engineering, equipment procurement and construction
        for solar installations, alongside system performance checks and annual
        yield audits.
      </p>
      <a class="text-link" href="/about/">
        About Incetekh <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </section>
  <section class="care-band" aria-labelledby="care-heading">
    <div class="container section">
      <div class="section-grid">
        <p class="eyebrow">Solar, with ongoing care</p>
        <h2 class="section-title" id="care-heading">
          From the first visit.
          <br />
          Beyond installation.
        </h2>
      </div>
      <div class="care-content">
        <div>
          <dl class="service-list">
            <div>
              <dt>Solar EPC</dt>
              <dd>
                Engineering, procurement and construction for your installation.
              </dd>
            </div>
            <div>
              <dt>System performance checks</dt>
              <dd>Understand how your existing solar system is performing.</dd>
            </div>
            <div>
              <dt>Annual yield audits</dt>
              <dd>An annual review of your system's energy generation.</dd>
            </div>
          </dl>
          <p class="warranty-note">
            <strong>5-year warranty</strong>, subject to the written proposal
            and applicable warranty terms.
          </p>
          <a class="text-link" href="/services/">
            See Our Services <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
        <figure class="care-image">
          <Image
            src={metalRoofImage.src}
            alt={metalRoofImage.alt}
            widths={[480, 800, 1080]}
            sizes="(max-width: 896px) 90vw, 40vw"
            format="webp"
            quality={80}
          />
          <figcaption>
            Metal-roof installation / Incetekh project archive
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
  <Manufacturers />
  <Testimonials />
  <SiteCTA />
</SiteLayout>

<style>
  .intro {
    padding-top: clamp(3rem, 6.5vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4.5rem);
  }
  .intro-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .intro-label span {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-accent);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(16rem, 1fr);
    gap: var(--space-8) clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  h1 {
    font-size: clamp(2.5rem, 4.8vw, 4.75rem);
    line-height: 1.12;
    letter-spacing: -0.055em;
  }
  h1 span {
    color: var(--color-muted);
  }
  .intro-copy {
    color: var(--color-muted);
    font-size: var(--text-lead);
    max-width: 28rem;
    padding-bottom: 0.4rem;
  }
  .intro-copy .button {
    margin-top: var(--space-6);
  }
  .care-band {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .care-band .eyebrow {
    color: var(--color-on-dark-muted);
  }
  .company-summary {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(3.5rem, 6vw, 6rem);
    align-items: start;
  }
  .company-summary .eyebrow {
    margin-bottom: 1.5rem;
    color: var(--color-accent);
  }
  .company-summary h2 {
    font-size: clamp(1.875rem, 2.8vw, 2.75rem);
  }
  .project-proof {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .project-proof strong {
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    color: var(--color-ink);
  }
  .care-band .section-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .care-content {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: clamp(2rem, 7vw, 7rem);
    margin-top: 3rem;
    align-items: start;
  }
  .service-list {
    margin: 0;
  }
  .service-list > div {
    border-top: 1px solid #626961;
    padding-block: 1.5rem;
  }
  dt {
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  dd {
    margin: 0.5rem 0 0;
    color: var(--color-on-dark-muted);
    max-width: 32rem;
  }
  .warranty-note {
    border-top: 1px solid #626961;
    padding-top: 1.5rem;
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
  }
  .care-content .text-link {
    margin-top: 1.5rem;
  }
  .care-image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .care-image figcaption {
    color: var(--color-on-dark-muted);
  }
  @media (max-width: 56rem) {
    .company-summary,
    .care-content {
      grid-template-columns: 1fr;
    }
  }
  .project-image {
    margin-bottom: 0;
  }
  .project-image img {
    width: 100%;
    aspect-ratio: 2.35 / 1;
    object-fit: cover;
    object-position: center 60%;
    background: var(--color-line);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  @media (max-width: 56rem) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: clamp(2.25rem, 6.4vw, 4rem);
    }
    .project-image img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
