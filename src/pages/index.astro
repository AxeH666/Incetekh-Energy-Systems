---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteCTA from '../components/SiteCTA.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import Manufacturers from '../components/Manufacturers.astro';
import Testimonials from '../components/Testimonials.astro';
import { foundationImage, metalRoofImage } from '../data/site';
---

<SiteLayout title="Incetekh Energy | Solar Engineering & EPC">
  <section class="hero" aria-labelledby="page-title">
    <div class="hero-inner">
      <div class="intro">
        <p class="eyebrow">Incetekh Energy / Solar EPC</p>
        <h1 id="page-title">
          Solar engineering.
          <br />
          <span>Built on experience.</span>
        </h1>
        <div class="intro-copy">
          <p>
            More than 13 years of experience. Engineering, procurement and
            construction, with care that continues after installation.
          </p>
          <WhatsAppLink label="Book a free site visit" />
          <a class="hero-link text-link" href="/projects/">
            Explore our work <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
      </div>
      <figure class="hero-image">
        <Image
          src={foundationImage.src}
          alt={foundationImage.alt}
          widths={[480, 800, 1280]}
          sizes="(max-width: 896px) 100vw, 85vw"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>On the roof. In the details.</figcaption>
      </figure>
    </div>
    <div class="container proof-line">
      <p class="project-proof">
        <strong>500+</strong> projects completed
      </p>
      <p>
        <strong>13+</strong> years of experience
      </p>
      <a class="text-link" href="/about/">
        Meet Incetekh <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </section>

  <section
    class="free-services section"
    aria-labelledby="free-services-heading"
  >
    <div class="container">
      <div class="services-intro">
        <div>
          <p class="eyebrow">Three services. No charge.</p>
          <h2 class="section-title" id="free-services-heading">
            Good advice.
            <br />
            Right from the start.
          </h2>
        </div>
        <p>
          Planning a new installation or looking after an existing one? Start
          with the support you need, free of charge.
        </p>
      </div>
      <div class="free-service-list">
        <a href="/services/#site-visit">
          <span class="service-label">01 / Free</span>
          <h3>Site visits</h3>
          <p>Talk through your site, roof space and solar plans with us.</p>
          <span class="service-detail-link">
            Explore site visits <span aria-hidden="true">&#8599;</span>
          </span>
        </a>
        <a href="/services/#system-care">
          <span class="service-label">02 / Free</span>
          <h3>System performance checks</h3>
          <p>Understand how your existing solar system is performing.</p>
          <span class="service-detail-link">
            Explore performance checks <span aria-hidden="true">&#8599;</span>
          </span>
        </a>
        <a href="/services/#system-care">
          <span class="service-label">03 / Free</span>
          <h3>Annual yield audits</h3>
          <p>Review your system's energy generation over the year.</p>
          <span class="service-detail-link">
            Explore yield audits <span aria-hidden="true">&#8599;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section
    class="container project-story section"
    aria-labelledby="experience-heading"
  >
    <figure>
      <Image
        src={metalRoofImage.src}
        alt={metalRoofImage.alt}
        widths={[480, 800, 1080]}
        sizes="(max-width:896px) 90vw, 45vw"
        format="webp"
        quality={80}
      />
      <figcaption>From the Incetekh project archive</figcaption>
    </figure>
    <div class="project-story-copy">
      <p class="eyebrow">From planning to the rooftop</p>
      <h2 id="experience-heading" class="section-title">
        One team.
        <br />
        Every stage of solar.
      </h2>
      <p class="lead">Engineering. Procurement. Construction.</p>
      <p>
        We bring the site, equipment and installation together, with ongoing
        system care after the work is complete.
      </p>
      <p class="warranty-note">
        <strong>5-year warranty</strong>
        <br />
        Subject to the written proposal and applicable warranty terms.
      </p>
      <a class="text-link" href="/services/">
        See our services <span aria-hidden="true">&#8599;</span>
      </a>
    </div>
  </section>
  <Manufacturers />
  <Testimonials />
  <SiteCTA />
</SiteLayout>

<style>
  .hero {
    background: #172720;
    color: #fff;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    max-width: 100rem;
    margin: auto;
  }
  .intro {
    padding: clamp(3rem, 6vw, 6rem) clamp(1.25rem, 4.5vw, 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .intro .eyebrow {
    color: #c9d6c8;
    margin-bottom: 2rem;
  }
  h1 {
    font-size: clamp(2.5rem, 4.3vw, 4.7rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
  }
  h1 span {
    color: #c2d0c1;
  }
  .intro-copy {
    margin-top: 1.75rem;
    max-width: 28rem;
  }
  .intro-copy p {
    color: #d2dcd3;
    font-size: var(--text-lead);
    margin-bottom: 2rem;
  }
  .hero-link {
    display: flex;
    width: fit-content;
    margin-top: 0.75rem;
    color: #fff;
  }
  .hero :focus-visible {
    outline-color: #f7b097;
  }
  .hero-image {
    position: relative;
    min-width: 0;
    background: #314035;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 1.18;
    object-position: 48% center;
  }
  .hero-image figcaption {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: #172720;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    color: #fff;
  }
  .proof-line {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: 1.5rem;
  }
  .proof-line p {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    font-size: var(--text-small);
    color: #d2dcd3;
  }
  .proof-line strong {
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    color: #fff;
  }
  .proof-line a {
    margin-left: auto;
  }
  .free-services {
    background: #fff;
  }
  .services-intro {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 3rem;
  }
  .services-intro > p {
    max-width: 29rem;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .eyebrow {
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .free-service-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }
  .free-service-list > a {
    display: flex;
    flex-direction: column;
    align-items: start;
    text-decoration: none;
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .service-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .free-service-list h3 {
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.035em;
    margin: 1.25rem 0 1rem;
    max-width: 20rem;
  }
  .free-service-list p {
    font-size: 0.9375rem;
    color: var(--color-muted);
    max-width: 22rem;
  }
  .service-detail-link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    font-size: var(--text-small);
    font-weight: 600;
    padding-top: 1.5rem;
    margin-top: auto;
  }
  .free-service-list a:hover .service-detail-link {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .project-story {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
  }
  .project-story img {
    width: 100%;
    aspect-ratio: 1.15;
    object-fit: cover;
  }
  .project-story figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .project-story-copy > p:not(.eyebrow) {
    margin-top: 1.5rem;
    max-width: 28rem;
    color: var(--color-muted);
  }
  .warranty-note {
    font-size: var(--text-small);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .warranty-note strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .project-story .text-link {
    margin-top: 1.5rem;
  }
  @media (max-width: 56rem) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .intro {
      padding-block: 3rem;
    }
    .hero-image img {
      height: auto;
      aspect-ratio: 1.9;
    }
    .services-intro,
    .project-story {
      grid-template-columns: 1fr;
    }
    .services-intro {
      gap: 1.5rem;
    }
    .proof-line {
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .project-story img {
      aspect-ratio: 1.6;
    }
  }
  @media (max-width: 44rem) {
    h1 {
      font-size: clamp(2.5rem, 8.5vw, 3.75rem);
    }
    .proof-line {
      column-gap: 1.5rem;
      row-gap: 1rem;
    }
    .proof-line p {
      display: block;
      flex: 1;
      min-width: 7rem;
    }
    .proof-line strong {
      display: block;
    }
    .proof-line a {
      margin-left: 0;
    }
    .free-service-list {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .free-service-list h3 {
      max-width: none;
      margin-top: 0.75rem;
    }
    .free-service-list p {
      max-width: none;
    }
    .hero-image img {
      aspect-ratio: 1.5;
    }
  }
</style>
