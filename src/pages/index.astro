---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteCTA from '../components/SiteCTA.astro';
import Testimonials from '../components/Testimonials.astro';
import { foundationImage, site } from '../data/site';
---

<SiteLayout title="Incetekh Energy | Solar Engineering & EPC">
  <section class="intro container" aria-labelledby="page-title">
    <p class="eyebrow intro-label">
      <span aria-hidden="true"></span> Solar EPC
    </p>
    <div class="intro-grid">
      <h1 id="page-title">
        Solar engineering.
        <br />
        <span>Built on experience.</span>
      </h1>
      <div class="intro-copy">
        <p>
          Approximately 15 years of operating experience in solar engineering,
          procurement and construction.
        </p>
        <a class="text-link" href={`tel:${site.phone}`}>
          Arrange a free site visit <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <figure class="project-image container">
    <Image
      src={foundationImage.src}
      alt={foundationImage.alt}
      widths={[480, 800, 1280]}
      sizes="(min-width: 1600px) 1440px, 91vw"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
    <figcaption>
      <span class="eyebrow">Rooftop solar</span>
      <a class="text-link" href="/projects/">
        View installation photographs <span aria-hidden="true">↗</span>
      </a>
    </figcaption>
  </figure>
  <section
    class="section container section-grid"
    aria-labelledby="experience-heading"
  >
    <p class="eyebrow">Experience, on the ground</p>
    <div class="prose">
      <h2 id="experience-heading" class="section-title">
        Every roof is different.
        <br />
        Start with yours.
      </h2>
      <p class="lead">
        Good solar decisions begin with the site, the way you use electricity,
        and the questions that matter to you.
      </p>
      <p>
        Incetekh Energy is an established solar EPC business, built over
        approximately 15 years and grown through word of mouth. We bring that
        experience to the conversation about your next installation.
      </p>
      <a class="text-link" href="/about/">
        Meet Incetekh <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="care-band" aria-labelledby="care-heading">
    <div class="container section">
      <div class="section-grid">
        <p class="eyebrow">Solar, with ongoing care</p>
        <h2 class="section-title" id="care-heading">
          From the first visit.
          <br />
          Beyond installation.
        </h2>
      </div>
      <dl class="service-list">
        <div>
          <dt>
            <span>01</span> Solar EPC
          </dt>
          <dd>
            Engineering, procurement and construction for your solar
            installation.
          </dd>
        </div>
        <div>
          <dt>
            <span>02</span> System performance checks
          </dt>
          <dd>
            A service for checking how your existing solar system is performing.
          </dd>
        </div>
        <div>
          <dt>
            <span>03</span> Annual yield audits
          </dt>
          <dd>An annual review of your system’s energy generation.</dd>
        </div>
        <div>
          <dt>
            <span>04</span> 5-year warranty
          </dt>
          <dd>
            Available under the written proposal and applicable warranty terms.
            Confirm coverage for your installation before proceeding.
          </dd>
        </div>
      </dl>
      <a class="text-link" href="/services/">
        Explore our services <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <Testimonials />
  <SiteCTA />
</SiteLayout>

<style>
  .intro {
    padding-top: clamp(3rem, 6.5vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 4.5vw, 4.5rem);
  }
  .intro-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .intro-label span {
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-accent);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(14rem, 1fr);
    gap: var(--space-8);
    align-items: end;
  }
  h1 {
    font-size: clamp(2.5rem, 5.4vw, 5.4rem);
    line-height: 1.12;
    letter-spacing: -0.06em;
  }
  h1 span {
    color: var(--color-muted);
  }
  .intro-copy {
    color: var(--color-muted);
    font-size: var(--text-lead);
    max-width: 28rem;
    padding-bottom: 0.4rem;
  }
  .intro-copy .text-link {
    margin-top: var(--space-6);
  }
  .care-band {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .care-band .eyebrow {
    color: var(--color-on-dark-muted);
  }
  .service-list {
    margin: var(--space-12) 0 0;
  }
  .service-list > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    border-top: 1px solid #626961;
    padding-block: var(--space-8);
  }
  dt {
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  dt span {
    color: var(--color-accent-bright);
    font-size: var(--text-small);
    margin-right: var(--space-6);
  }
  dd {
    margin: 0;
    color: var(--color-on-dark-muted);
    max-width: 32rem;
  }
  @media (max-width: 44rem) {
    .service-list > div {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
  .project-image {
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }
  .project-image img {
    width: 100%;
    aspect-ratio: 2.35 / 1;
    object-fit: cover;
    object-position: center 60%;
    background: var(--color-line);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  @media (max-width: 56rem) {
    .intro-grid {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: clamp(2.25rem, 6.4vw, 4rem);
    }
    .project-image img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
