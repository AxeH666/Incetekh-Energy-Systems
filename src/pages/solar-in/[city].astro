---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WhatsAppLink from '../../components/WhatsAppLink.astro';
import { cities, cityPath } from '../../data/cities';
import { site } from '../../data/site';
import { centralSubsidy, planning, solarSources } from '../../data/solar';

export function getStaticPaths() {
  return cities.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}
const { city } = Astro.props;
const money = (value: number) => new Intl.NumberFormat('en-IN').format(value);
const products = [
  {
    title: 'Solar panels',
    description:
      'Start with the roof, then choose modules that fit the space, system design and scheme requirements.',
    href: '/products/#panels',
    link: 'Explore panels',
  },
  {
    title: 'Solar inverters',
    description:
      'Match power conversion to your connection and energy needs. Discuss backup as a separate design requirement.',
    href: '/products/#inverters',
    link: 'Explore inverters',
  },
  {
    title: 'Solar water heaters',
    description:
      'Use the sun for hot water. Compare tank sizes and suitability for your household, water supply and roof.',
    href: '/products/#water-heaters',
    link: 'Explore water heaters',
  },
];
const sizes = [
  { kw: 3, title: 'Everyday home use' },
  { kw: 5, title: 'Growing energy needs' },
  { kw: 7, title: 'Higher-consumption homes' },
  { kw: 10, title: 'Larger roofs & businesses' },
];
const steps = [
  {
    title: 'Discuss your site',
    text: 'Share your location and a recent electricity bill. Confirm availability for a free site visit.',
  },
  {
    title: 'Agree on the design',
    text: 'Review roof suitability, system size, equipment and a written proposal. Check scheme eligibility before ordering.',
  },
  {
    title: 'Install & commission',
    text: 'Agree the installation schedule and the required DISCOM approvals, inspection and metering arrangements.',
  },
  {
    title: 'Apply & look after it',
    text: 'Complete eligible subsidy steps through the official portal. Discuss performance checks and annual yield audits.',
  },
];
---

<SiteLayout
  title={`Rooftop Solar in ${city.name} | Incetekh Energy`}
  description={`Planning rooftop solar in ${city.name}? Explore system sizes, products and eligible household subsidy. Check free site-visit availability with Incetekh Energy.`}
>
  <section class="city-hero" aria-labelledby="city-title">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Solar in {city.name}</span>
      </nav>
      <div class="hero-copy">
        <p class="eyebrow">Andhra Pradesh / Rooftop solar</p>
        <h1 id="city-title">
          Rooftop solar in <span>{city.name}.</span>
        </h1>
        <p class="lead">
          A clearer plan for your roof. Explore the equipment, compare system
          sizes and understand the next steps for your home or business.
        </p>
        <div class="action-row">
          <a class="button button-dark" href="#city-enquiry">
            Plan a free site visit
          </a>
          <a class="button button-outline" href={`tel:${site.phone}`}>
            Call {site.phoneDisplay}
          </a>
        </div>
        <p class="availability">
          Based in Proddatur. Site-visit availability in {city.name} is
          confirmed when you enquire.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="city-planning-heading">
    <div class="container city-intro">
      <div class="section-heading">
        <p class="eyebrow">Start with your property</p>
        <h2 class="section-title" id="city-planning-heading">
          Make your roof part of the plan.
        </h2>
      </div>
      <div class="prose">
        <p class="lead">
          Considering solar in {city.name}? Your electricity use and usable roof
          space are the best starting points.
        </p>
        <p>
          Review shade, roof condition, access and your connection before
          choosing a system. A home, shop and commercial building can need very
          different designs, even on roofs of the same size.
        </p>
        <p>
          Incetekh brings more than 13 years of solar EPC experience and 500+
          completed projects. Tell us where your property is so we can discuss
          suitability and visit arrangements.
        </p>
        <a class="text-link" href="/projects/">
          See work from our project archive
        </a>
      </div>
    </div>
  </section>

  <section
    class="section city-products"
    aria-labelledby="city-products-heading"
  >
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Equipment & selection</p>
        <h2 class="section-title" id="city-products-heading">
          Products for your property.
        </h2>
        <p>
          Build around what you need. Models, availability and warranties are
          confirmed in your proposal.
        </p>
      </div>
      <div class="product-grid">
        {products.map((product, index) => (
          <article class="product-card">
            <p class="eyebrow">0{index + 1} / Equipment</p>
            <h3>{product.title}</h3>
            <p>{product.description}</p>
            <a class="text-link" href={product.href}>
              {product.link}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section city-subsidy" aria-labelledby="city-subsidy-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">PM Surya Ghar / Residential</p>
        <h2 class="section-title" id="city-subsidy-heading">
          Up to ₹78,000 for eligible {city.name} homes.
        </h2>
        <p>
          Central assistance for eligible residential rooftop solar, subject to
          scheme conditions and approval.
        </p>
      </div>
      <dl class="subsidy-grid">
        {[1, 2, 3].map((kw) => (
          <div>
            <dt>{kw === 3 ? '3 kW and above' : `${kw} kW system`}</dt>
            <dd>₹{money(centralSubsidy(kw, true))}</dd>
          </div>
        ))}
      </dl>
      <p class="section-note">
        For eligible new household systems. Commercial connections and solar
        water heaters are excluded. Confirm requirements with your DISCOM and
        the National Portal before purchasing; payment is not guaranteed.
      </p>
      <div class="action-row centered-actions">
        <a class="text-link" href="/solar-guide/#subsidy">
          Read the subsidy guide
        </a>
        <a class="text-link" href={solarSources.subsidy}>
          Official central subsidy rates
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="city-sizes-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Compare your options</p>
        <h2 class="section-title" id="city-sizes-heading">
          A size that fits your needs.
        </h2>
        <p>
          Use these starting points to plan a conversation about your property
          in {city.name}.
        </p>
      </div>
      <div class="size-grid">
        {sizes.map(({ kw, title }) => (
          <article class="size-card">
            <h3>
              {kw}
              {kw === 10 ? '+' : ''} <span>kW</span>
            </h3>
            <p class="size-title">{title}</p>
            <p>
              About {kw * planning.roofM2PerKw} m² clear roof
              <br />
              About {money(kw * planning.dailyYield * 30)} units / month
            </p>
            <a class="text-link" href="#city-enquiry">
              Discuss {kw === 10 ? '10+ kW' : `${kw} kW`}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
      <p class="section-note">
        Illustrations use 4 units per kW per day, a 30-day month and 10 m² of
        clear roof per kW. The 10+ kW example shows 10 kW. Shade, weather,
        layout and actual usage change the result. These are not generation or
        backup guarantees.
      </p>
      <div class="centered-actions action-row">
        <a class="text-link" href="/#solar-planner">
          Estimate a size from your electricity bill
        </a>
      </div>
    </div>
  </section>

  <section class="section city-process" aria-labelledby="city-process-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">From first conversation to system care</p>
        <h2 class="section-title" id="city-process-heading">
          Know what comes next.
        </h2>
        <p>
          A practical route to solar. Your schedule depends on the site,
          equipment and approvals.
        </p>
      </div>
      <ol class="process-grid">
        {steps.map((step, index) => (
          <li>
            <span class="step-number" aria-hidden="true">
              0{index + 1}
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="section"
    id="city-enquiry"
    aria-labelledby="city-enquiry-heading"
  >
    <div class="container enquiry-panel">
      <div class="section-heading">
        <p class="eyebrow">In and around {city.name}</p>
        <h2 class="section-title" id="city-enquiry-heading">
          Let’s talk about your roof.
        </h2>
        <p>
          Share your locality or pincode and a recent electricity bill. We’ll
          confirm visit availability and discuss the right next step.
        </p>
      </div>
      <div class="enquiry-actions">
        <WhatsAppLink
          label={`Ask about a visit in ${city.name}`}
          message={`Hi Incetekh, I am planning solar in ${city.name}. Is a free site visit available? My locality / pincode is: `}
        />
        <a class="text-link" href={`tel:${site.phone}`}>
          Or call {site.phoneDisplay}
        </a>
        <p>
          Confirm arrangements directly with the team. Opening WhatsApp does not
          send a message or book a visit.
        </p>
      </div>
    </div>
  </section>

  <section class="section other-cities" aria-labelledby="other-cities-heading">
    <div class="container">
      <div class="section-heading centered">
        <p class="eyebrow">Explore by location</p>
        <h2 class="section-title" id="other-cities-heading">
          Planning somewhere else?
        </h2>
        <p>
          Explore another city, then check availability for your exact location.
        </p>
      </div>
      <nav class="location-links" aria-label="Other city solar guides">
        {cities
          .filter((other) => other.slug !== city.slug)
          .map((other) => (
            <a href={cityPath(other.slug)}>{other.name}</a>
          ))}
      </nav>
    </div>
  </section>
</SiteLayout>

<style>
  .city-hero {
    background: #e8eee3;
    border-bottom: 1px solid #d5ded1;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding-top: 1rem;
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-underline-offset: 0.3em;
  }
  .hero-copy {
    max-width: 54rem;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-8) 0 var(--section-space);
  }
  .eyebrow {
    color: var(--color-accent);
  }
  h1 {
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    line-height: 1.12;
    letter-spacing: -0.05em;
    margin-block: 1rem 1.5rem;
  }
  h1 span {
    color: var(--color-green);
  }
  .hero-copy .lead {
    max-width: 42rem;
    margin-inline: auto;
    color: var(--color-muted);
  }
  .hero-copy .action-row {
    justify-content: center;
    margin-top: var(--space-8);
  }
  .availability {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 1.5rem auto 0;
    max-width: 38rem;
  }
  .city-intro {
    display: grid;
    grid-template-columns: 0.85fr 1.3fr;
    gap: var(--layout-gap);
  }
  .section-heading .eyebrow {
    margin-bottom: 0.75rem;
  }
  .section-heading > p:last-child:not(.eyebrow) {
    margin-top: 1rem;
    color: var(--color-muted);
  }
  .centered {
    max-width: 46rem;
    margin: 0 auto var(--heading-gap);
    text-align: center;
  }
  .city-products,
  .city-process {
    background: #eceee7;
  }
  .product-grid,
  .subsidy-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  .product-card h3,
  .process-grid h3 {
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.025em;
    margin: 1rem 0 0.75rem;
  }
  .product-card > p:not(.eyebrow) {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .product-card .text-link {
    margin-top: auto;
    padding-top: 1.5rem;
  }
  .city-subsidy {
    background: #20372d;
    color: #fff;
  }
  .city-subsidy .eyebrow {
    color: #f4b59b;
  }
  .city-subsidy .section-heading > p:last-child,
  .city-subsidy .section-note {
    color: #d9e3d6;
  }
  .city-subsidy :focus-visible {
    outline-color: #f4b59b;
  }
  .subsidy-grid {
    margin: 0 auto;
    max-width: 58rem;
  }
  .subsidy-grid > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.5rem;
    text-align: center;
    padding: var(--card-padding);
    border-top: 1px solid #698073;
  }
  dt {
    color: #d9e3d6;
    font-size: var(--text-small);
  }
  dd {
    margin: 0;
    font-size: clamp(2rem, 3vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .section-note {
    max-width: 58rem;
    margin: var(--space-6) auto 0;
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: center;
  }
  .centered-actions {
    justify-content: center;
    margin-top: 1rem;
  }
  .size-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
  }
  .size-card {
    display: flex;
    flex-direction: column;
    align-items: start;
    border-top: 2px solid #758a78;
    padding-top: var(--space-6);
  }
  .size-card h3 {
    font-size: 2.5rem;
    line-height: 1.2;
    letter-spacing: -0.04em;
  }
  .size-card h3 span {
    font-size: 1.25rem;
  }
  .size-title {
    margin: 1rem 0 0.5rem;
    font-weight: 600;
  }
  .size-card p {
    font-size: var(--text-small);
  }
  .size-card p:not(.size-title) {
    color: var(--color-muted);
  }
  .size-card .text-link {
    margin-top: auto;
    padding-top: 1rem;
  }
  .process-grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .process-grid li {
    border-top: 1px solid #b9c3b5;
    padding-top: 1.5rem;
  }
  .step-number {
    color: var(--color-green);
    font-size: 1.5rem;
  }
  .process-grid p {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  .enquiry-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--layout-gap);
    align-items: center;
  }
  .enquiry-actions {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.75rem;
  }
  .enquiry-actions p {
    color: var(--color-muted);
    font-size: var(--text-small);
    max-width: 30rem;
  }
  .other-cities {
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-12);
  }
  .location-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-6);
    max-width: 64rem;
    margin-inline: auto;
  }
  .location-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-block: var(--space-2);
    text-decoration: none;
    font-size: var(--text-small);
  }
  .location-links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  @media (max-width: 64rem) {
    .size-grid,
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
  @media (max-width: 48rem) {
    .city-intro,
    .enquiry-panel,
    .product-grid {
      grid-template-columns: 1fr;
    }
    .subsidy-grid {
      gap: 0.75rem;
    }
    .subsidy-grid > div {
      padding: 1.25rem 0.5rem;
    }
    dd {
      font-size: 1.75rem;
    }
  }
  @media (max-width: 36rem) {
    .hero-copy .button {
      width: 100%;
    }
    .hero-copy .action-row {
      gap: 0.75rem;
    }
    .subsidy-grid,
    .size-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }
    .subsidy-grid > div {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 1.25rem;
    }
    .centered {
      text-align: left;
    }
    .section-note {
      text-align: left;
    }
    .centered-actions {
      justify-content: flex-start;
    }
  }
</style>
