---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found | Incetekh Energy"
  description="This page could not be found. Return to Incetekh Energy."
>
  <div class="container error-page">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found.</h1>
    <p>The address may have changed. You can return to the homepage.</p>
    <a class="button button-dark" href="/">
      Back to home <span aria-hidden="true">↗</span>
    </a>
  </div>
</SiteLayout>

<style>
  .error-page {
    padding-block: clamp(4rem, 10vw, 10rem);
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.05em;
    line-height: 1.15;
    margin-block: var(--space-6);
  }
  .error-page > p:not(.eyebrow) {
    color: var(--color-muted);
    max-width: 36rem;
    margin-bottom: var(--space-8);
  }
</style>
