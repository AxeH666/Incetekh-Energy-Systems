---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteVisitForm from '../components/SiteVisitForm.astro';
---

<SiteLayout
  title="Solar Preview | Incetekh Energy"
  description="A preliminary rooftop solar concept, followed by a free physical site visit."
  noindex
>
  <section class="section preview-shell">
    <div class="container">
      <p class="eyebrow">Preliminary assessment · English preview</p>
      <h1>See solar on your roof.</h1>
      <p id="preview-status" role="status" tabindex="-1">
        Solar Preview is currently unavailable. You can still use our calculator
        or arrange a free site visit.
      </p>
      <div id="preview-intro" hidden>
        <section id="bill-summary" aria-labelledby="bill-heading">
          <h2 id="bill-heading">Your bill-based estimate</h2>
          <p id="bill-summary-text"></p>
          <p>
            This uses the calculator's ₹8/unit and 4 units/kW/day scenario,
            rounded up to a whole kW. It does not establish rooftop space.
          </p>
        </section>
        <p>
          Choose your actual building on Google satellite imagery. Opening the
          map shares network and location information with Google. Solar data
          and satellite imagery may have different dates.
        </p>
        <p>
          <a href="https://policies.google.com/privacy">
            Google Privacy Policy
          </a>{' '}
          ·{' '}
          <a href="https://maps.google.com/help/terms_maps/">
            Google Maps terms
          </a>{' '}
          · <a href="/privacy/">Our privacy notice</a>
        </p>
        <button type="button" id="open-map">
          Open property map
        </button>
      </div>
      <div id="property-controls" hidden>
        <div
          id="property-search"
          aria-label="Search for an address or business"
        ></div>
        <p>
          Search for your property or click the map to place the selection
          marker. Confirm the actual building before requesting an assessment.
        </p>
        <form id="coordinate-form">
          <label>
            Latitude{' '}
            <input
              name="latitude"
              type="number"
              step="any"
              min="12"
              max="20"
              required
            />
          </label>
          <label>
            Longitude{' '}
            <input
              name="longitude"
              type="number"
              step="any"
              min="75"
              max="85"
              required
            />
          </label>
          <button type="submit">Move selection</button>
        </form>
        <p id="selection-label">No property selected.</p>
        <div id="solar-security"></div>
        <button id="assess-property" type="button" disabled>
          This is my building — assess roof
        </button>
        <div id="returned-building" hidden>
          <p id="returned-location"></p>
          <p>
            Google returned the building marked in orange. Its bounds are
            approximate. Confirm this is the same roof you selected; nearby
            buildings can be returned instead.
          </p>
          <button id="accept-roof" type="button">
            This returned roof is correct
          </button>
          <button id="reject-roof" type="button">
            Wrong building — select again
          </button>
        </div>
        <div id="roof-controls" hidden>
          <button id="before-solar" type="button" aria-pressed="false">
            Show Before
          </button>
          <button id="unusable-roof" type="button">
            Roof changed, unclear or panels misplaced
          </button>
        </div>
        <div id="solar-map" aria-label="Google satellite property map"></div>
        <p id="solar-source" hidden>
          Source: Includes solar data from Google. Proposed panels are a
          preliminary concept, not an installation design.
        </p>
        <p id="roof-details"></p>
        <section
          id="roof-results"
          hidden
          aria-labelledby="roof-results-heading"
        >
          <h2 id="roof-results-heading">Preliminary rooftop estimate</h2>
          <label for="roof-configuration">Returned rooftop configuration</label>
          <select id="roof-configuration"></select>
          <p id="roof-comparison"></p>
          <p id="roof-limited" hidden>
            Not enough rooftop space for the estimated system. If you have other
            available space, please contact our office.
          </p>
          <dl>
            <div>
              <dt>Proposed model panels</dt>
              <dd id="result-panels"></dd>
            </div>
            <div>
              <dt>Modeled rooftop capacity</dt>
              <dd id="result-capacity"></dd>
            </div>
            <div>
              <dt>Google annual DC energy estimate</dt>
              <dd id="result-dc"></dd>
            </div>
            <div>
              <dt>Illustrative annual AC generation</dt>
              <dd id="result-ac"></dd>
            </div>
            <div>
              <dt>Average monthly AC generation</dt>
              <dd id="result-monthly"></dd>
            </div>
            <div>
              <dt>Illustrative generation value / potential savings</dt>
              <dd id="result-value"></dd>
            </div>
          </dl>
          <p>
            AC illustration = Google's annual DC estimate × 0.85, an
            Incetekh-approved planning assumption (version 2026-10-18.1), not a
            verified local efficiency. No second loss factor is applied.
          </p>
          <p>
            Value assumes all generation offsets use or earns ₹8/unit credit,
            averaged over 12 months. This is not guaranteed bill reduction.
            Fixed charges, actual export credit, consumption timing and seasonal
            variation are not modeled.
          </p>
          <p id="panel-model"></p>
        </section>
      </div>
      <p class="preview-links">
        <a href="/#solar-planner" id="back-calculator">
          Return to calculator
        </a>{' '}
        ·{' '}
        <a href="#site-visit" id="preview-visit">
          Book a free site visit
        </a>
      </p>
      <noscript>
        <p>
          The map needs JavaScript. Our calculator and contact options remain
          available.
        </p>
      </noscript>
    </div>
  </section>
  <SiteVisitForm preview />
</SiteLayout>
<script>
  import '../scripts/solar-preview';
</script>
<style>
  .preview-shell h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
  }
  .preview-shell p {
    max-width: 75ch;
  }
  .preview-shell button {
    padding: 0.85rem 1.2rem;
    min-height: 44px;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: white;
    cursor: pointer;
    margin: 0.4rem 0.5rem 0.4rem 0;
  }
  .preview-shell button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  #coordinate-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
    margin-block: 1rem;
  }
  #coordinate-form label {
    display: grid;
    gap: 0.25rem;
    flex: 1 1 150px;
  }
  #coordinate-form input {
    width: 100%;
    box-sizing: border-box;
    min-height: 44px;
    padding: 0.5rem;
  }
  #solar-map {
    width: 100%;
    height: min(65vh, 700px);
    min-height: 340px;
    background: #e2e6e6;
    margin-block: 1rem;
  }
  #preview-status {
    padding-block: 1rem;
  }
  #returned-building {
    border-left: 3px solid #ad5b14;
    padding-left: 1rem;
  }
  #roof-results dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-block: 1.5rem;
  }
  #roof-results dd {
    margin: 0.4rem 0;
    font-size: 1.4rem;
    font-weight: 600;
  }
  #roof-results select {
    max-width: 100%;
    min-height: 44px;
    padding: 0.5rem;
  }
  .preview-links {
    margin-top: 2rem;
  }
  [hidden] {
    display: none !important;
  }
</style>
