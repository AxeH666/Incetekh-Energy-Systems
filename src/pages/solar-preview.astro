---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteVisitForm from '../components/SiteVisitForm.astro';
---

<SiteLayout
  title="Solar Preview | Incetekh Energy"
  description="A preliminary rooftop solar concept, followed by a free physical site visit."
  noindex
>
  <section class="section preview-shell">
    <div class="container">
      <p class="eyebrow">Preliminary rooftop preview</p>
      <h1>See solar on your roof.</h1>
      <p class="preview-steps">
        1. Enter address &nbsp; → &nbsp; 2. Confirm roof &nbsp; → &nbsp; 3. See
        solar
      </p>
      <p id="preview-status" role="status" tabindex="-1">
        Solar Preview is currently unavailable. You can still use our calculator
        or arrange a free site visit.
      </p>
      <div id="preview-intro" hidden>
        <p id="chosen-system"></p>
        <details id="bill-summary">
          <summary>Calculator details</summary>
          <p id="bill-summary-text"></p>
          <p>
            This uses the calculator's ₹8/unit and 4 units/kW/day scenario,
            rounded up to a whole kW. It does not establish rooftop space.
          </p>
        </details>
        <p>
          Find your address, then check the pin is on your roof. Address search
          and the map share your search and location with Google.
        </p>
        <p>
          <a href="https://policies.google.com/privacy">
            Google Privacy Policy
          </a>{' '}
          ·{' '}
          <a href="https://maps.google.com/help/terms_maps/">
            Google Maps terms
          </a>{' '}
          · <a href="/privacy/">Our privacy notice</a>
        </p>
        <button type="button" id="open-map">
          Enter your address
        </button>
      </div>
      <div id="property-controls" hidden>
        <div
          id="property-search"
          aria-label="Search for an address or business"
        ></div>
        <p>
          Select your address from the suggestions. If needed, tap your roof on
          the map to move the pin.
        </p>
        <p id="selection-label">No property selected.</p>
        <div id="solar-map" aria-label="Google satellite property map"></div>
        <div id="solar-security"></div>
        <button id="assess-property" type="button" disabled>
          Confirm roof &amp; preview
        </button>
        <div id="returned-building" hidden>
          <p id="returned-location"></p>
          <p>
            We could not confidently match the roof data to your pin. Tap the
            middle of your roof and try again, or arrange a site visit.
          </p>
          <button id="reject-roof" type="button">
            Choose roof again
          </button>
        </div>
        <div id="roof-controls" hidden>
          <button id="before-solar" type="button" aria-pressed="false">
            Show Before
          </button>
          <button id="panel-view" type="button" aria-pressed="false">
            Closer view
          </button>
          <button id="grouped-layout" type="button" hidden>
            Try grouped layout
          </button>
          <button id="unusable-roof" type="button">
            Panels don't match my roof
          </button>
        </div>
        <p id="roof-limited" hidden>
          Not enough rooftop space for the estimated system. If you have other
          available space, please contact our office.
        </p>
        <p id="grouped-layout-note" hidden role="status"></p>
        <p id="solar-source" hidden>
          Source: Includes solar data from Google. Proposed panels are a
          preliminary concept, not an installation design.
        </p>
        <section
          id="roof-results"
          hidden
          aria-labelledby="roof-results-heading"
        >
          <h2 id="roof-results-heading">Your solar preview</h2>
          <p class="google-attribution" translate="no">
            Includes data from <span>Google Maps</span>
          </p>

          <dl>
            <div>
              <dt>Proposed model panels</dt>
              <dd id="result-panels"></dd>
            </div>
            <div>
              <dt>Modeled rooftop capacity</dt>
              <dd id="result-capacity"></dd>
            </div>
            <div>
              <dt>Average monthly AC generation</dt>
              <dd id="result-monthly"></dd>
            </div>
            <div>
              <dt>Illustrative generation value / potential savings</dt>
              <dd id="result-value"></dd>
            </div>
          </dl>
          <p>
            Preliminary layout. Roof condition, access and installation
            feasibility need a site visit.
          </p>
          <details>
            <summary>Layout and calculation details</summary>
            <label for="roof-configuration">
              Compare available system sizes
            </label>
            <select id="roof-configuration"></select>
            <p id="roof-comparison"></p>
            <p id="roof-details"></p>
            <p>
              Google annual DC estimate: <span id="result-dc"></span>.
            </p>
            <p>
              Illustrative annual AC generation: <span id="result-ac"></span>.
            </p>
            <p>
              AC illustration = Google's annual DC estimate × 0.85, an
              Incetekh-approved planning assumption (version 2026-10-18.1), not
              a verified local efficiency. No second loss factor is applied.
            </p>
            <p>
              Value assumes all generation offsets use or earns ₹8/unit credit,
              averaged over 12 months. This is not guaranteed bill reduction.
              Fixed charges, actual export credit, consumption timing and
              seasonal variation are not modeled.
            </p>
            <p id="panel-model"></p>
          </details>
        </section>
      </div>
      <p class="preview-links">
        <a href="/#solar-planner" id="back-calculator">
          Return to calculator
        </a>{' '}
        ·{' '}
        <a href="#site-visit" id="preview-visit">
          Book a free site visit
        </a>
      </p>
      <noscript>
        <p>
          The map needs JavaScript. Our calculator and contact options remain
          available.
        </p>
      </noscript>
    </div>
  </section>
  <details id="preview-enquiry" class="container">
    <summary>Book a free site visit</summary>
    <SiteVisitForm preview />
  </details>
</SiteLayout>
<script>
  import '../scripts/solar-preview';
</script>
<style>
  .preview-shell {
    padding-block: 2.5rem;
  }
  .preview-shell h1 {
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
  }
  .preview-shell p {
    max-width: 75ch;
  }
  .preview-shell button {
    padding: 0.85rem 1.2rem;
    min-height: 44px;
    border: 1px solid var(--color-ink);
    background: var(--color-ink);
    color: white;
    cursor: pointer;
    margin: 0.4rem 0.5rem 0.4rem 0;
  }
  .preview-shell button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  details {
    margin-block: 1rem;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
    padding-block: 0.65rem;
  }
  #property-search {
    max-width: 640px;
  }
  #open-map {
    min-width: min(100%, 320px);
    text-align: left;
    background: white;
    color: var(--color-ink);
  }
  #chosen-system {
    font-weight: 600;
  }
  #solar-map {
    width: 100%;
    height: min(65vh, 700px);
    min-height: 340px;
    background: #e2e6e6;
    margin-block: 1rem;
  }
  #preview-status {
    padding-block: 1rem;
  }
  #returned-building {
    border-left: 3px solid #ad5b14;
    padding-left: 1rem;
  }
  #roof-results dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-block: 1.5rem;
  }
  #roof-results dd {
    margin: 0.4rem 0;
    font-size: 1.4rem;
    font-weight: 600;
  }
  .google-attribution {
    font-family: sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: normal;
    color: #1f1f1f;
  }
  .google-attribution span {
    white-space: nowrap;
  }
  #roof-results select {
    max-width: 100%;
    min-height: 44px;
    padding: 0.5rem;
  }
  .preview-links {
    margin-top: 2rem;
  }
  [hidden] {
    display: none !important;
  }
</style>
