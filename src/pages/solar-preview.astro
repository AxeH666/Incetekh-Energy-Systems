---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteVisitForm from '../components/SiteVisitForm.astro';
import SolarAddressSearch from '../components/SolarAddressSearch.astro';
---

<SiteLayout
  title="Solar Preview | Incetekh Energy"
  description="A preliminary rooftop solar concept, followed by a free physical site visit."
  noindex
>
  <section class="section preview-shell">
    <div class="container">
      <header class="preview-heading">
        <p class="eyebrow">Preliminary rooftop preview</p>
        <h1>See solar on your roof.</h1>
        <ol class="preview-steps" aria-label="Preview steps" role="list">
          <li>
            <span aria-hidden="true">01</span> Enter address
          </li>
          <li>
            <span aria-hidden="true">02</span> Confirm roof
          </li>
          <li>
            <span aria-hidden="true">03</span> See solar
          </li>
        </ol>
      </header>
      <p id="preview-status" role="status" tabindex="-1">
        Solar Preview is currently unavailable. You can still use our calculator
        or arrange a free site visit.
      </p>
      <div id="preview-intro" hidden>
        <p id="chosen-system"></p>
        <details id="bill-summary">
          <summary>Calculator details</summary>
          <p id="bill-summary-text"></p>
          <p>
            This uses the calculator's ₹8/unit and 4 units/kW/day scenario,
            rounded up to a whole kW. It does not establish rooftop space.
          </p>
        </details>
        <p>
          Find your address, then check the pin is on your roof. Address search
          and the map share your search and location with Google.
        </p>
        <p class="privacy-links">
          <a href="https://policies.google.com/privacy">
            Google Privacy Policy
          </a>{' '}
          ·{' '}
          <a href="https://maps.google.com/help/terms_maps/">
            Google Maps terms
          </a>{' '}
          · <a href="/privacy/">Our privacy notice</a>
        </p>
        <button type="button" id="open-map" class="button button-dark">
          Enter your address
        </button>
      </div>
      <div id="property-controls" hidden>
        <SolarAddressSearch />
        <p id="selection-label">No property selected.</p>
        <div id="solar-map" aria-label="Google satellite property map"></div>
        <div id="solar-security"></div>
        <button
          id="assess-property"
          class="button button-dark"
          type="button"
          disabled
        >
          Confirm roof &amp; preview
        </button>
        <div id="returned-building" hidden>
          <p id="returned-location"></p>
          <button
            id="confirm-detected-roof"
            class="button button-dark"
            type="button"
            hidden
            disabled
          >
            Yes, show solar here
          </button>
          <button id="reject-roof" class="button button-outline" type="button">
            No, choose another roof
          </button>
        </div>
        <div id="roof-controls" hidden>
          <button
            id="before-solar"
            class="button button-outline"
            type="button"
            aria-pressed="false"
          >
            Show Before
          </button>
          <button
            id="panel-view"
            class="button button-outline"
            type="button"
            aria-pressed="false"
          >
            Closer view
          </button>
          <button
            id="grouped-layout"
            class="button button-outline"
            type="button"
            hidden
          >
            Try grouped layout
          </button>
          <button
            id="unusable-roof"
            class="button button-outline"
            type="button"
          >
            Panels don't match my roof
          </button>
        </div>
        <p id="roof-limited" hidden>
          Not enough rooftop space for the estimated system. If you have other
          available space, please contact our office.
        </p>
        <p id="grouped-layout-note" hidden role="status"></p>
        <details id="module-details" hidden>
          <summary>Module and layout assumptions</summary>
          <p id="module-assumptions"></p>
          <a
            href="https://waaree.com/upload/media/datasheet_bi_55_520_550_12_03012025_1756379026.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            Official Waaree module datasheet
          </a>
        </details>
        <p id="module-unavailable" hidden>
          The reference-module layout could not be verified in the available
          roof model. Showing Google's original model instead; this is not a
          Waaree installation layout.
        </p>
        <p id="solar-source" hidden>
          Source: Includes solar data from Google. Proposed panels are a
          preliminary concept, not an installation design.
        </p>
        <section
          id="roof-results"
          hidden
          aria-labelledby="roof-results-heading"
        >
          <h2 id="roof-results-heading">Your solar preview</h2>
          <p class="google-attribution" translate="no">
            Includes data from <span>Google Maps</span>
          </p>

          <dl>
            <div>
              <dt>Proposed model panels</dt>
              <dd id="result-panels"></dd>
            </div>
            <div>
              <dt>Modeled rooftop capacity</dt>
              <dd id="result-capacity"></dd>
            </div>
            <div>
              <dt>Average monthly AC generation</dt>
              <dd id="result-monthly"></dd>
            </div>
            <div>
              <dt>Illustrative generation value / potential savings</dt>
              <dd id="result-value"></dd>
            </div>
          </dl>
          <p>
            Preliminary layout. Roof condition, access and installation
            feasibility need a site visit.
          </p>
          <details>
            <summary>Layout and calculation details</summary>
            <label for="roof-configuration">
              Compare available system sizes
            </label>
            <select id="roof-configuration"></select>
            <p id="roof-comparison"></p>
            <p id="roof-details"></p>
            <p>
              Google annual DC estimate: <span id="result-dc"></span>.
            </p>
            <p>
              Illustrative annual AC generation: <span id="result-ac"></span>.
            </p>
            <p>
              AC illustration = Google's annual DC estimate × 0.85, an
              Incetekh-approved planning assumption (version 2026-10-18.1), not
              a verified local efficiency. No second loss factor is applied.
            </p>
            <p>
              Value assumes all generation offsets use or earns ₹8/unit credit,
              averaged over 12 months. This is not guaranteed bill reduction.
              Fixed charges, actual export credit, consumption timing and
              seasonal variation are not modeled.
            </p>
            <p id="panel-model"></p>
          </details>
        </section>
      </div>
      <p class="preview-links">
        <a href="/#solar-planner" id="back-calculator" class="text-link">
          Return to calculator
        </a>
        <a href="#site-visit" id="preview-visit" class="text-link">
          Book a free site visit
        </a>
      </p>
      <noscript>
        <p>
          The map needs JavaScript. Our calculator and contact options remain
          available.
        </p>
      </noscript>
    </div>
  </section>
  <details id="preview-enquiry" class="container">
    <summary>Book a free site visit</summary>
    <SiteVisitForm preview />
  </details>
</SiteLayout>
<script>
  import '../scripts/solar-preview';
</script>
<style>
  .preview-shell {
    padding-block: var(--section-space) var(--space-8);
  }
  .preview-heading {
    margin-bottom: var(--space-8);
  }
  .preview-heading .eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .preview-shell h1 {
    font-size: var(--text-page-title);
    line-height: 1.15;
    letter-spacing: -0.045em;
  }
  .preview-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--color-line);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .preview-steps li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .preview-steps span {
    color: var(--color-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .preview-shell p {
    max-width: 75ch;
  }
  #preview-intro {
    max-width: 52rem;
    padding: var(--card-padding);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  #preview-intro > p + p {
    margin-top: 1rem;
  }
  .privacy-links {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  details {
    margin-block: var(--space-6);
    border-block: 1px solid var(--color-line);
  }
  details[open] {
    padding-bottom: var(--space-4);
  }
  details p + p {
    margin-top: var(--space-3);
  }
  details p {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  summary {
    cursor: pointer;
    min-height: 3rem;
    padding-block: 0.85rem;
    font-size: var(--text-small);
    font-weight: 600;
  }
  summary::marker {
    color: var(--color-green);
  }
  #selection-label {
    margin-top: var(--space-4);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  #open-map {
    margin-top: var(--space-6);
  }
  #chosen-system {
    color: var(--color-green);
    font-size: var(--text-lead);
    font-weight: 600;
  }
  #solar-map {
    width: 100%;
    height: min(65vh, 700px);
    min-height: 340px;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-line);
    margin-block: 1rem;
  }
  #solar-security {
    margin-block: var(--space-4);
  }
  #preview-status:not(:empty) {
    padding: 1rem 1.25rem;
    margin-block: var(--space-4);
    border-left: 3px solid var(--color-green);
    background: var(--color-surface-soft);
    font-size: var(--text-small);
    overflow-wrap: anywhere;
  }
  #returned-building {
    border: 1px solid #c4aa7b;
    border-radius: var(--radius);
    background: #faf5e9;
    padding: var(--card-padding);
    margin-block: var(--space-6);
  }
  #returned-building p {
    margin-bottom: var(--space-4);
  }
  #returned-building .button {
    margin: 0.25rem 0.5rem 0.25rem 0;
  }
  #roof-controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block: var(--space-6);
  }
  #roof-controls [aria-pressed='true'] {
    background: var(--color-green);
    color: #fff;
  }
  #solar-source,
  #module-unavailable,
  #grouped-layout-note,
  #roof-limited {
    margin-block: var(--space-4);
    font-size: var(--text-small);
    color: var(--color-muted);
  }
  #roof-results {
    padding: var(--card-padding);
    margin-top: var(--space-8);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  #roof-results h2 {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-3);
  }
  #roof-results dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.5rem;
    margin-block: 1.5rem;
  }
  #roof-results dl > div {
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-4);
    min-width: 0;
  }
  #roof-results dt {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
  #roof-results dd {
    margin: 0.4rem 0;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--color-green);
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .google-attribution {
    font-family: sans-serif;
    font-style: normal;
    font-weight: 400;
    font-size: 14px;
    letter-spacing: normal;
    color: #1f1f1f;
  }
  .google-attribution span {
    white-space: nowrap;
  }
  #roof-results select {
    max-width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    margin-block: var(--space-3);
    border: 1px solid var(--color-field-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-ink);
  }
  #roof-results label {
    display: block;
    font-size: var(--text-small);
    font-weight: 600;
  }
  .preview-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 2rem;
  }
  #preview-enquiry {
    margin-block: 0 var(--section-space);
  }
  #preview-enquiry > summary {
    font-size: 1rem;
    padding-block: var(--space-6);
  }
  #preview-enquiry :global(.site-visit) {
    background: transparent;
    padding-bottom: 0;
  }
  #preview-enquiry :global(.visit-grid) {
    width: 100%;
  }
  @media (max-width: 36rem) {
    .preview-shell {
      padding-top: var(--space-8);
    }
    .preview-heading {
      margin-bottom: var(--space-6);
    }
    .preview-steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: var(--space-6);
      padding-block: var(--space-4);
      font-size: 0.75rem;
    }
    .preview-steps li,
    .preview-steps span {
      display: block;
    }
    .preview-steps span {
      margin-bottom: 0.25rem;
    }
    #bill-summary {
      margin-block: var(--space-4);
    }
  }
  [hidden] {
    display: none !important;
  }
</style>
