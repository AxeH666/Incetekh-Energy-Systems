---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SiteCTA from '../components/SiteCTA.astro';
import { metalRoofImage } from '../data/site';
---

<SiteLayout
  title="Company | Incetekh Energy"
  description="Get to know Incetekh Energy, an established solar EPC business with approximately 15 years of operating experience and roots in word of mouth."
>
  <PageIntro
    eyebrow="The company"
    title="Built through work. Grown by word of mouth."
    description="Incetekh Energy brings approximately 15 years of operating experience to solar engineering, procurement and construction."
  />
  <section class="container story" aria-labelledby="story-heading">
    <figure>
      <Image
        src={metalRoofImage.src}
        alt={metalRoofImage.alt}
        widths={[480, 800, 1080]}
        sizes="(max-width: 704px) 90vw, 45vw"
        format="webp"
        quality={80}
      />
      <figcaption>
        Solar installation on a metal roof · Incetekh project archive
      </figcaption>
    </figure>
    <div class="prose">
      <p class="eyebrow">Our foundation</p>
      <h2 class="section-title" id="story-heading">
        Experience built
        <br />
        over time.
      </h2>
      <p class="lead">
        For much of our history, new conversations have started with a
        recommendation.
      </p>
      <p>
        Our public presence is a new way to get to know the business behind
        those recommendations: the work we do, photographs from our
        installations, and a direct way to speak with us.
      </p>
      <p>
        We work in solar EPC and offer system performance checks and annual
        yield audits. Whether you are considering a new rooftop system or
        discussing an existing one, the starting point is a conversation about
        your site.
      </p>
      <a class="text-link" href="/services/">
        Explore our services <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section
    class="container section section-grid company-note"
    aria-labelledby="approach-heading"
  >
    <p class="eyebrow">A practical starting point</p>
    <div class="prose">
      <h2 class="section-title" id="approach-heading">
        Your site. Your questions.
      </h2>
      <p>
        Solar is a site-specific decision. Speak to us about roof space,
        electricity use and the type of installation you are considering. A free
        site visit is available to begin that discussion.
      </p>
      <p>
        Confirm the proposed work, commercial details and applicable warranty
        terms in writing before you proceed.
      </p>
    </div>
  </section>
  <SiteCTA />
</SiteLayout>

<style>
  .story {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    padding-bottom: var(--space-16);
  }
  .story img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  figcaption {
    color: var(--color-muted);
    font-size: var(--text-small);
    margin-top: var(--space-4);
  }
  .company-note {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  @media (max-width: 44rem) {
    .story {
      grid-template-columns: 1fr;
    }
  }
</style>
