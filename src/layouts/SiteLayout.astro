---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import logo from '../../incetekh_logo.png';
import {
  indexable,
  analyticsToken,
  googleVerification,
} from '../data/visibility';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({
  src: logo,
  width: 600,
  format: 'jpg',
});
const favicon = await getImage({ src: logo, width: 64, format: 'png' });
const touchIcon = await getImage({ src: logo, width: 180, format: 'png' });
const socialImageUrl = new URL(socialImage.src, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': new URL('/#organization', Astro.site).href,
      name: site.name,
      url: Astro.site?.href,
      telephone: [site.phone, site.secondaryPhone],
      description: site.description,
      logo: socialImageUrl.href,
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', Astro.site).href,
      name: site.name,
      url: Astro.site?.href,
      publisher: { '@id': new URL('/#organization', Astro.site).href },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4ef" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable && !noindex ? 'index, follow' : 'noindex, follow'}
    />
    {!noindex && <link rel="canonical" href={canonical} />}
    {googleVerification && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    <link rel="icon" type="image/png" sizes="64x64" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={socialImage.attributes.width} />
    <meta property="og:image:height" content={socialImage.attributes.height} />
    <meta property="og:image:alt" content="Incetekh Solar logo" />
    <meta name="twitter:card" content="summary" />
    {Astro.url.pathname === '/' && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {analyticsToken && !noindex && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </body>
</html>
