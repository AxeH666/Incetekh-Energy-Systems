{
  "name": "incetekh-energy-systems",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/solar-preview", "/solar-preview/*"],
    "not_found_handling": "404-page",
  },
  // Solar stays disabled until approved usage limits and live acceptance.
  "vars": {
    "SOLAR_PREVIEW_ENABLED": "false",
    "SOLAR_MATCHED_IMAGERY_ENABLED": "false",
    "SOLAR_ALLOWED_ORIGIN": "https://incetekhenergy.com",
    // Proposed trial limits; inactive while SOLAR_PREVIEW_ENABLED is false.
    "SOLAR_DAILY_LIMIT": "10",
    "SOLAR_MONTHLY_LIMIT": "100",
    "LEAD_CAPTURE_ENABLED": "true",
    "LEAD_CAPTURE_ENV": "production",
    "LEAD_ALLOWED_ORIGIN": "https://incetekhenergy.com",
    // Owner-approved activation. Keep this cutoff fixed; never backfill old leads.
    "EMAIL_NOTIFY_ENABLED": "true",
    "EMAIL_NOTIFY_SINCE": "2026-10-17T10:26:08.400Z",
    // Retain existing production flags until separately approved cleanup.
    "WHATSAPP_NOTIFY_ENABLED": "false",
    "WHATSAPP_WEBHOOK_ENABLED": "false",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "incetekh-site-visits-prod",
      "database_id": "e5db446c-699e-4e19-8db0-816a3b83f3ad",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "LEAD_RATE_LIMIT",
      "namespace_id": "2026101502",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      // Unused in the account inventory; separate from both lead namespaces.
      "name": "SOLAR_RATE_LIMIT",
      "namespace_id": "2026101801",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "previews": {
    // Enable only after preview migration and runtime secrets are verified.
    "vars": {
      "SOLAR_PREVIEW_ENABLED": "false",
      "SOLAR_MATCHED_IMAGERY_ENABLED": "false",
      "LEAD_CAPTURE_ENABLED": "false",
      "LEAD_CAPTURE_ENV": "preview",
      "EMAIL_NOTIFY_ENABLED": "false",
      "LEAD_ALLOWED_ORIGIN": "https://feat-site-visit-lead-capture-incetekh-energy-systems.incetekhenergy.workers.dev",
    },
    "d1_databases": [
      {
        "binding": "LEADS_DB",
        "database_name": "incetekh-site-visits-preview",
        "database_id": "e38a341f-de7f-48be-9195-917c9695b13a",
        "migrations_dir": "migrations",
      },
    ],
    // Preview-only; no collision in account inventory checked 15 October 2026.
    "ratelimits": [
      {
        "name": "LEAD_RATE_LIMIT",
        "namespace_id": "2026101501",
        "simple": { "limit": 5, "period": 60 },
      },
    ],
  },
}
