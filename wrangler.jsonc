{
  "name": "incetekh-energy-systems",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  // Capture stays closed until separately approved resources and secrets exist.
  "vars": { "LEAD_CAPTURE_ENABLED": "false" },
  "previews": { "vars": { "LEAD_CAPTURE_ENABLED": "false" } },
}
